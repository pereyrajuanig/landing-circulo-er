{
  "name": "circulo-er-editorial",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.16.0 <25"
  },
  "scripts": {
    "dev": "sanity dev --host 127.0.0.1 --port 3333",
    "build": "sanity build",
    "check": "tsc --noEmit",
    "deploy": "sanity deploy",
    "login": "sanity login",
    "import:archive": "sanity exec scripts/import-archive.ts --with-user-token"
  },
  "dependencies": {
    "@sanity/client": "8.14.1",
    "@sanity/locale-es-es": "1.2.39",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sanity": "6.22.0",
    "styled-components": "6.6.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "6.0.3"
  },
  "overrides": {
    "@vercel/frameworks": {
      "js-yaml": "3.15.2",
      "smol-toml": "1.9.1"
    },
    "@module-federation/dts-plugin": {
      "undici": "7.30.1"
    }
  }
}
