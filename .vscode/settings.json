{
  "files.encoding": "utf8",
  "files.eol": "\n",
  "editor.tabSize": 2,
  "files.exclude": {
    "**/.DS_Store": true
  },
  "search.exclude": {
    "dist": true,
    "node_modules": true,
    ".astro": true
  },
  "eslint.validate": ["javascript", "typescript", "astro"],
  "[astro]": {
    "editor.defaultFormatter": "astro-build.astro-vscode"
  },
  "prettier.requireConfig": true
}
