{
  "name": "landing-circulo-er",
  "version": "1.2.0",
  "private": true,
  "description": "Landing institucional del Círculo de Retirados y Pensionados de la Policía de Entre Ríos",
  "type": "module",
  "engines": {
    "node": ">=24.16.0 <25"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "npm run build && npm run test:unit && playwright test && npm run test:csp",
    "build": "astro build && node scripts/check-build.mjs && node scripts/check-security.mjs",
    "preview": "astro preview",
    "test:update": "npm run build && node scripts/update-content-contract.mjs",
    "validate": "npm run security:repo && npm run check && npm run lint && npm run format:check && npm test",
    "test:unit": "node --test --test-reporter=spec tests/landing.test.mjs",
    "test:e2e": "npm run build && playwright test",
    "test:install": "playwright install chromium",
    "perf": "npm run build && node tools/performance/measure.mjs",
    "security:update": "astro build && node scripts/update-security-policy.mjs",
    "test:csp": "playwright test --config playwright.csp.config.mjs",
    "security:repo": "node scripts/check-security.mjs --repository"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pereyrajuanig/landing-circulo-er.git"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "astro": "7.3.8",
    "eslint": "10.12.0",
    "eslint-plugin-astro": "3.2.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  }
}
