---
import { Image } from 'astro:assets';
import { referencePhotos } from '../lib/reference-photos';
import type { ReferencePhotoKind } from '../lib/reference-photos';
interface Props {
  kind: ReferencePhotoKind;
  variant?: 'wide' | 'compact' | 'card';
  loading?: 'eager' | 'lazy';
}
const { kind, variant = 'wide', loading = 'lazy' } = Astro.props;
const photo = referencePhotos[kind];
const sizes =
  variant === 'wide'
    ? '(max-width: 800px) calc(100vw - 44px), 1240px'
    : '(max-width: 800px) calc(100vw - 44px), 600px';
---

<figure class:list={['reference-photo', 'reference-photo--' + variant]} data-reference-photo>
  <div class="reference-photo-frame">
    <Image
      src={photo.src}
      alt={photo.alt}
      format="webp"
      quality={78}
      width={1440}
      widths={[480, 960, 1440]}
      sizes={sizes}
      loading={loading}
      fetchpriority={loading === 'eager' ? 'high' : undefined}
    />
    <span class="reference-photo-badge">FOTO DE REFERENCIA</span>
  </div>
  <figcaption>
    {photo.note}
    <span class="photo-credit">
      <a href={photo.source} target="_blank" rel="noopener noreferrer">
        Foto: {photo.author} / Pexels ↗
      </a>
    </span>
  </figcaption>
</figure>
