---
import { sanidadWhatsApp } from '../lib/contact';
import groups from '../data/reintegros-oser.json';
import LineIcon from './LineIcon.astro';
import PhotoGallery from './PhotoGallery.astro';
import SitePhoto from './SitePhoto.astro';

interface Props {
  address: string;
}

const { address } = Astro.props;
const count = groups.reduce((total, { items }) => total + items.length, 0);
const schedule = [
  {
    service: 'Atención médica',
    name: 'Leticia Cichitti',
    license: '7112',
    hours: 'Lunes, miércoles y jueves, de 10:30 a 11:30.',
    mode: 'Por orden de llegada.',
  },
  {
    service: 'Cardiología',
    name: 'Mario Tizzini',
    license: '7030',
    hours: 'Martes, de 09:00 a 11:00.',
    mode: 'Por orden de llegada.',
  },
  {
    service: 'Nutrición',
    name: 'María Romero Dri',
    license: '655',
    hours: 'Martes, de 08:00 a 12:00.',
    mode: 'Por orden de llegada.',
  },
  {
    service: 'Enfermería',
    name: 'Amanda Silvestre',
    license: '12879',
    hours: 'Lunes a viernes, de 08:00 a 12:00.',
  },
  { service: 'Fonoaudiología', name: 'Valentina Cabrera', hours: 'Miércoles, de 09:00 a 11:00.' },
  {
    service: 'Podología',
    name: 'Lorena De Giusto',
    license: '247',
    hours: 'Lunes y jueves.',
    phone: '422-6361',
  },
  {
    service: 'Masajes',
    name: 'Andrea Díaz Paz',
    hours: 'Lunes, de 12:00 a 17:00. Martes, de 12:30 a 16:30. Viernes, de 11:00 a 14:00.',
  },
];
const opticians = [
  { name: 'Óptica Visión', address: 'Urquiza 760', phone: '431-1165' },
  { name: 'Optinova', address: '25 de Mayo 341', phone: '423-3104' },
];
const phoneLink = (phone: string) => 'tel:+54343' + phone.replace('-', '');
---

<section
  class="sanidad-section sanidad-feature sanidad-refund"
  aria-labelledby="reintegros-oser"
  data-reimbursements
>
  <p class="eyebrow dark">Para afiliados de toda Entre Ríos</p>
  <h3 id="reintegros-oser">Reintegros mensuales de prestaciones OSER</h3>
  <p>
    Si estás afiliado al Círculo y tenés OSER, podés acceder al beneficio de reintegros{' '}
    <strong>mes a mes, desde cualquier localidad</strong>. Consultá en tu filial o en Sanidad cómo
    presentar la solicitud del <strong>Código 817</strong> y qué documentación necesitás.
  </p>
  <a class="text-link" href="/institucion/#filiales">
    Buscá tu filial
  </a>
  <details class="reimbursement-catalog">
    <summary aria-controls="prestaciones-panel">
      <span>Ver las {count} prestaciones y sus códigos</span>
      <LineIcon name="next" size={20} />
    </summary>
    <div id="prestaciones-panel" class="catalog-body">
      <p>
        Buscá la práctica o el código que figura en tu orden. Algunas denominaciones están
        abreviadas, tal como figuran en el listado de Sanidad.
      </p>
      <div class="catalog-filter" data-reimbursement-search hidden>
        <label for="buscar-prestacion">Buscar por prestación o código</label>
        <input id="buscar-prestacion" type="search" aria-controls="listado-reintegros" />
        <p role="status" data-reimbursement-status></p>
      </div>
      <div id="listado-reintegros" class="catalog">
        {groups.map(({ category, items }) => (
          <details>
            <summary>{category}</summary>
            <table aria-label={category}>
              <thead>
                <tr>
                  <th scope="col">Prestación</th>
                  <th scope="col">Código OSER</th>
                </tr>
              </thead>
              <tbody>
                {items.map(({ code, name }) => (
                  <tr data-reimbursement-row data-search={name + ' ' + code}>
                    <td>{name}</td>
                    <td>{code}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </details>
        ))}
      </div>
    </div>
  </details>
</section>

<section class="sanidad-section sanidad-feature sanidad-optical" aria-labelledby="plan-optico">
  <div class="optical-copy">
    <h3 id="plan-optico">Plan Óptico Solidario</h3>
    <p>
      <strong>Un par de anteojos de cerca y uno de lejos, sin cargo</strong>, para la persona
      afiliada y su cónyuge. El beneficio se renueva cada dos años.
    </p>
    <div class="optical-request">
      <h4>Pedí el formulario en tu filial</h4>
      <p>
        Podés solicitarlo desde cualquier localidad. En tu filial te indican cómo retirar y renovar
        los anteojos.
      </p>
      <a class="text-link" href="/institucion/#filiales">
        Buscá tu filial
      </a>
    </div>
  </div>
  <SitePhoto
    kind="federacion-beneficio-lentes"
    variant="card"
    sizes="(max-width: 820px) 90vw, 30vw"
  />
  <div class="optical-directory">
    <h4>Ópticas adheridas en Paraná</h4>
    <ul>
      {opticians.map(({ name, address, phone }) => (
        <li>
          <h5>{name}</h5>
          <p>{address}</p>
          <a class="text-link" href={phoneLink(phone)}>
            (0343) {phone}
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<section
  class="sanidad-section sanidad-central"
  id="atencion-parana"
  aria-labelledby="atencion-parana-title"
>
  <div class="central-intro">
    <div class="central-copy">
      <h3 id="atencion-parana-title">Atención en la sede central de Paraná</h3>
      <p class="central-address">
        <LineIcon name="pin" size={22} /> {address}, Paraná.
      </p>
      <aside aria-label="WhatsApp de Sanidad">
        <p>Consultá por atención, kinesiología y orientación sobre recetas.</p>
        <a class="central-contact" href={sanidadWhatsApp.href}>
          Escribir a Sanidad por WhatsApp <LineIcon name="arrow" size={22} />
        </a>
        <p class="central-contact-number">{sanidadWhatsApp.number}</p>
      </aside>
      <a class="central-hours-link" href="#especialidades-parana">
        Ver especialidades y horarios
      </a>
    </div>
    <div class="central-photos">
      <h4>Fotos de los consultorios</h4>
      <PhotoGallery
        id="salud-parana"
        title="Consultorios de Paraná"
        note="Consultá qué especialidades atienden actualmente y cómo pedir turno."
        photoKeys={[
          'parana-consultorio-02',
          'parana-podologia-03',
          'parana-consultorio-equipamiento',
          'parana-consultorio-mobiliario',
        ]}
        compact
      />
    </div>
  </div>
  <div class="central-schedule">
    <h4 id="especialidades-parana">Especialidades y horarios</h4>
    <ul class="schedule-list">
      {schedule.map(({ service, name, license, hours, mode, phone }) => (
        <li>
          <div>
            <h5>{service}</h5>
            <p class="schedule-practitioner">
              {name}
              {license && <> · M.P. {license}</>}
            </p>
          </div>
          <div>
            <p>{hours}</p>
            {mode && <p class="schedule-mode">{mode}</p>}
            {phone && (
              <p>
                Turnos:{' '}
                <a class="text-link" href={phoneLink(phone)}>
                  (0343) {phone}
                </a>
              </p>
            )}
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<section class="sanidad-section consultation-panel" aria-labelledby="ambulancia-parana">
  <h3 id="ambulancia-parana">Ambulancia para afiliados en Paraná</h3>
  <p>
    <strong>MEDICAL Servicio</strong> · Belgrano 459, Paraná.
  </p>
  <ul aria-label="Teléfonos de MEDICAL Servicio">
    <li>
      <a class="text-link" href={phoneLink('423-2219')}>
        (0343) 423-2219
      </a>
    </li>
    <li>
      <a class="text-link" href={phoneLink('423-1222')}>
        (0343) 423-1222
      </a>
    </li>
  </ul>
</section>

<script>
  import { normalize } from '../lib/search';

  const catalog = document.querySelector('[data-reimbursements]');
  const control = catalog?.querySelector<HTMLElement>('[data-reimbursement-search]');
  const input = control?.querySelector('input');
  const status = control?.querySelector('[data-reimbursement-status]');
  if (catalog && control && input && status) {
    const groups = [...catalog.querySelectorAll<HTMLDetailsElement>('.catalog details')];
    control.hidden = false;
    input.addEventListener('input', () => {
      const query = normalize(input.value);
      let count = 0;
      for (const group of groups) {
        let matches = 0;
        for (const row of group.querySelectorAll<HTMLElement>('[data-reimbursement-row]')) {
          row.hidden = !normalize(row.dataset.search ?? '').includes(query);
          if (!row.hidden) matches++;
        }
        group.hidden = matches === 0;
        group.open = Boolean(query && matches);
        count += matches;
      }
      status.textContent = !query
        ? ''
        : count === 0
          ? 'No encontramos prestaciones con esa búsqueda.'
          : count === 1
            ? '1 prestación encontrada.'
            : count + ' prestaciones encontradas.';
    });
  }
</script>

<style>
  .sanidad-section {
    margin-block: 2rem;
    scroll-margin-top: 7rem;
  }
  .sanidad-section > h3,
  .optical-copy > h3 {
    scroll-margin-top: 7rem;
    margin-block-end: 1rem;
  }
  .sanidad-feature {
    padding: clamp(1.25rem, 3.5vw, 2.75rem);
    border: 1px solid #decca7;
    border-inline-start: 4px solid #895421;
    border-radius: 14px;
    background: #faf3e3;
  }

  .sanidad-feature > h3,
  .optical-copy > h3 {
    font: 400 clamp(2rem, 4vw, 3.5rem)/1.12 var(--serif);
  }

  .sanidad-feature p {
    max-width: 67ch;
  }
  .sanidad-optical {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
    gap: clamp(1.4rem, 4vw, 2.75rem);
    align-items: start;
    background: #fffaf1;
    border-inline-start: 1px solid #decca7;
    border-block-start: 3px solid var(--portal-red);
    border-radius: 0 0 10px 10px;
  }
  .sanidad-optical :global(.reference-photo) {
    width: min(100%, 18rem);
    justify-self: center;
  }
  .sanidad-optical :global(.reference-photo--card .reference-photo-frame) {
    aspect-ratio: 3 / 4;
    background: #f1e7d5;
  }
  .sanidad-optical :global(.reference-photo img) {
    object-fit: contain;
  }
  .optical-request {
    padding: clamp(1rem, 2vw, 1.4rem);
    border-inline-start: 3px solid #895421;
    background: #f3e7d1;
  }
  .optical-request h4,
  .optical-directory :is(h4, h5) {
    font: 700 1.125rem / 1.45 var(--sans);
    letter-spacing: normal;
  }
  .optical-request p {
    margin-block: 0.5rem 0;
  }
  .optical-request a,
  .optical-directory a {
    min-height: 44px;
  }
  .optical-directory {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: 1rem 1.75rem;
    padding-block-start: 1.25rem;
    border-block-start: 1px solid #decca7;
  }
  .optical-directory ul {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 11rem), 1fr));
    gap: 1rem 1.75rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .optical-directory h5,
  .optical-directory p {
    margin: 0;
  }
  .reimbursement-catalog {
    margin-block-start: 1.25rem;
  }
  .reimbursement-catalog > summary {
    list-style: none;
    padding: 0.75rem 1rem;
    min-height: 48px;
    background: #143a53;
    color: #fffaf1;
    border-radius: 8px;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    font-weight: 700;
  }
  .reimbursement-catalog > summary::-webkit-details-marker {
    display: none;
  }
  .reimbursement-catalog[open] > summary :global(svg) {
    transform: rotate(90deg);
  }
  .catalog-body {
    padding: 1rem clamp(0rem, 2vw, 1rem) 0;
  }
  #ambulancia-parana {
    font-size: clamp(1.65rem, 3vw, 2.45rem);
  }
  [aria-labelledby='ambulancia-parana'] {
    border-inline-start: 4px solid var(--portal-red-ink);
  }
  [aria-labelledby='ambulancia-parana'] a {
    font-weight: 700;
  }
  .sanidad-central {
    --central-inset: clamp(1.125rem, 4vw, 3rem);
    margin-block-start: clamp(2.75rem, 6vw, 5rem);
    border: 1px solid var(--ps-border);
    border-radius: 0.75rem;
    background: var(--paper);
  }
  .central-intro {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    align-items: stretch;
    border-block-start: 4px solid #d9b77d;
    border-radius: 0.7rem 0.7rem 0 0;
    overflow: hidden;
    background: var(--navy);
    color: var(--paper);
  }
  .central-copy {
    padding: var(--central-inset);
  }
  .central-copy h3 {
    max-width: 20ch;
    font: 400 clamp(2.15rem, 4vw, 3.5rem) / 1.07 var(--serif);
  }
  .central-copy .central-address {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 1rem 0 1.5rem;
    color: #f0d4a1;
    font-weight: 700;
  }
  .central-address :global(svg),
  .central-contact :global(svg) {
    flex: none;
  }
  .central-copy aside {
    padding-block-start: 1.05rem;
    border-block-start: 1px solid #d9b77d70;
  }
  .central-copy aside p {
    max-width: 40ch;
    margin-block-end: 0.85rem;
    color: inherit;
  }
  .central-contact {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    min-height: 48px;
    padding: 0.65rem 1rem;
    border: 1px solid #f0d4a1;
    border-radius: 0.35rem;
    background: #f0d4a1;
    color: var(--navy);
    font-weight: 750;
    line-height: 1.35;
  }
  .central-contact:hover {
    background: var(--paper);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
  .central-copy a:focus-visible {
    outline-color: #f0d4a1;
  }
  .central-copy .central-contact-number {
    margin: 0.65rem 0 0;
  }
  .central-hours-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-block-start: 0.65rem;
    color: #f0d4a1;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .central-photos {
    min-width: 0;
    padding: var(--central-inset) var(--central-inset) var(--central-inset) 0;
  }
  .central-photos h4 {
    margin-block-end: 0.75rem;
    font: 700 1.125rem / 1.4 var(--sans);
    letter-spacing: normal;
  }
  .central-photos :global(.photo-gallery-compact .photo-gallery-grid img) {
    height: clamp(13.5rem, 25vw, 21rem);
    aspect-ratio: auto;
  }
  .central-photos :global(.photo-rail :focus-visible) {
    outline-color: #f0d4a1;
  }
  .central-photos :global([data-gallery-open]:focus-visible) {
    outline-offset: -5px;
  }
  .central-schedule {
    padding: var(--central-inset);
  }
  .central-schedule h4 {
    font: 400 clamp(1.8rem, 3vw, 2.45rem) / 1.15 var(--serif);
    scroll-margin-top: 7rem;
  }
  .schedule-list {
    list-style: none;
    padding: 0;
    margin: 1.25rem 0 0;
    border-block-start: 2px solid #b9955b;
  }
  .schedule-list li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
    align-items: baseline;
    gap: 0.55rem 1.75rem;
    padding: 1rem 0.75rem;
    border-block-end: 1px solid var(--ps-border);
  }
  .schedule-list li:nth-child(even) {
    background: #f6f0e4;
  }
  .schedule-list h5 {
    margin: 0;
    font: 750 1.1875rem / 1.4 var(--sans);
    color: var(--navy);
  }
  .schedule-list p {
    margin: 0;
  }
  .schedule-list .schedule-practitioner,
  .schedule-list .schedule-mode {
    margin-block-start: 0.25rem;
  }
  .schedule-list a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: inherit;
    font-weight: 700;
    text-decoration: underline;
  }
  @media (max-width: 820px) {
    .sanidad-optical,
    .optical-directory {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 740px) {
    .central-intro,
    .schedule-list li {
      grid-template-columns: minmax(0, 1fr);
    }
    .central-photos {
      padding: var(--central-inset);
      border-block-start: 1px solid #d9b77d70;
    }
    .central-photos :global(.photo-gallery-compact .photo-gallery-grid img) {
      height: clamp(12rem, 55vw, 19rem);
    }
  }
  @media (max-width: 440px) {
    .catalog :is(th, td):last-child {
      width: 6rem;
      overflow-wrap: anywhere;
    }
  }
  .catalog-filter {
    margin-block-start: 1rem;
  }
  .catalog-filter label {
    display: block;
    font-weight: 650;
  }
  .catalog-filter input {
    color: inherit;
    background: var(--paper);
    border: 1px solid var(--muted);
    border-radius: 6px;
    width: min(100%, 32rem);
    min-height: 44px;
    padding: 0.55rem 0.75rem;
    font: inherit;
  }
  .catalog-filter p {
    margin-block: 0.4rem;
  }
  .catalog {
    margin-block-start: 1rem;
    border-block-start: 1px solid var(--ps-border);
  }
  .catalog details {
    border-block-end: 1px solid var(--ps-border);
  }
  .catalog summary {
    cursor: pointer;
    font-weight: 650;
    padding-block: 0.7rem;
  }
  .catalog table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 0.75rem;
  }
  .catalog :is(th, td) {
    text-align: start;
    padding: 0.45rem 0.5rem;
    border-block-end: 1px solid var(--ps-border);
  }
  .catalog :is(th, td):last-child {
    width: 8rem;
    font-variant-numeric: tabular-nums;
  }
</style>
