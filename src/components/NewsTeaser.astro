---
import { getCollection } from 'astro:content';
import { publishedNews } from '../lib/news';
const items = publishedNews(await getCollection('news')).slice(0, 3);
---

<section class="home-news" aria-labelledby="home-news-title">
  <div class="wrap">
    <div class="section-heading">
      <div>
        <p class="eyebrow dark">La vida del Círculo</p>
        <h2 id="home-news-title">Seguimos construyendo juntos.</h2>
      </div>
      <div>
        <p>Noticias, actividades y logros de nuestra institución.</p>
        <a class="text-link" href="/novedades/">
          Explorar novedades →
        </a>
      </div>
    </div>
    {items.length > 0 && (
      <div class="destination-grid">
        {items.map(({ id, data }) => (
          <article class="destination-entry">
            <p class="path-number">
              {data.category === 'logro' ? 'LOGROS DE GESTIÓN' : 'NOTICIAS'}
            </p>
            <h3>
              <a href={'/novedades/' + id + '/'}>{data.title}</a>
            </h3>
            <p>{data.summary}</p>
            <a class="text-link" href={'/novedades/' + id + '/'}>
              Leer publicación →
            </a>
          </article>
        ))}
      </div>
    )}
  </div>
</section>
