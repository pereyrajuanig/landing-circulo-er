---
import type { CollectionEntry } from 'astro:content';
interface Props {
  institution: CollectionEntry<'institution'>['data'];
  branches: CollectionEntry<'branches'>[];
}
const { institution, branches } = Astro.props;
---

<section id="filiales" class="section territory">
  <div class="wrap territory-grid">
    <div>
      <p class="eyebrow">05 / PRESENCIA PROVINCIAL</p>
      <h2>
        Cerca tuyo,
        <br />
        <em>en Entre Ríos.</em>
      </h2>
      <p>
        Desde la sede central en Paraná y nuestras filiales, buscamos que cada familia policial
        tenga un lugar al que acercarse. Encontrá tu localidad y consultanos cómo comunicarte.
      </p>
      <label for="branch-search">Encontrá tu localidad</label>
      <div class="search-field">
        <span aria-hidden="true">⌕</span>
        <input
          id="branch-search"
          type="search"
          placeholder="Escribí una localidad…"
          autocomplete="off"
          aria-controls="branch-list"
        />
      </div>
      <p
        class="search-status"
        role="status"
        aria-live="polite"
        aria-atomic="true"
        id="branch-status"
      ></p>
      <a class="text-link" href="/contacto/">
        Te ayudamos a contactar tu filial <span aria-hidden="true">→</span>
      </a>
    </div>
    <div class="branches">
      <a class="central-branch" href="/contacto/">
        <span>SEDE CENTRAL</span>
        <strong>{institution.city}</strong>
        <small>
          {institution.address} <span aria-hidden="true">↗</span>
        </small>
      </a>
      <ul id="branch-list" aria-label="Localidades con filiales">
        {branches.map((branch) => (
          <li>{branch.data.name}</li>
        ))}
      </ul>
    </div>
  </div>
</section>
