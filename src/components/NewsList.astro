---
import type { CollectionEntry } from 'astro:content';
import SitePhoto from './SitePhoto.astro';
interface Props {
  items: CollectionEntry<'news'>[];
}
const { items } = Astro.props;
---

{items.length > 0 ? (
  <div class="news-browser" data-news-browser>
    <div class="news-controls">
      <label class="news-search">
        Buscá una publicación
        <input
          type="search"
          id="news-search"
          placeholder="Tema o palabra clave"
          aria-controls="news-list"
        />
      </label>
      <div role="group" aria-label="Filtrar novedades" class="news-filters">
        <button type="button" data-category="all" aria-pressed="true">
          Todas
        </button>
        <button type="button" data-category="noticia" aria-pressed="false">
          Noticias
        </button>
        <button type="button" data-category="logro" aria-pressed="false">
          Logros de gestión
        </button>
      </div>
    </div>
    <p id="news-status" role="status" aria-live="polite" aria-atomic="true"></p>
    <ul id="news-list" class="news-list">
      {items.map(({ id, data }) => (
        <li
          data-news-item
          data-title={data.title}
          data-summary={data.summary}
          data-category={data.category}
        >
          <article>
            {data.cover && <SitePhoto kind={data.cover} variant="compact" />}
            <p class="path-number">
              {data.category === 'logro' ? 'LOGROS DE GESTIÓN' : 'NOTICIAS'} · PUBLICADO EL{' '}
              <time datetime={data.publishedAt}>
                {new Date(data.publishedAt).toLocaleDateString('es-AR', {
                  timeZone: 'America/Argentina/Buenos_Aires',
                  day: 'numeric',
                  month: 'long',
                  year: 'numeric',
                })}
              </time>
            </p>
            <h2>
              <a href={'/novedades/' + id + '/'}>{data.title}</a>
            </h2>
            <p>{data.summary}</p>
            <a class="text-link" href={'/novedades/' + id + '/'}>
              Leer publicación →
            </a>
          </article>
        </li>
      ))}
    </ul>
    <p id="news-empty" class="empty-copy" hidden>
      No encontramos publicaciones con esa búsqueda. Probá con otra palabra o categoría.
    </p>
  </div>
) : (
  <div class="news-empty-state">
    <p class="eyebrow dark">La vida del Círculo</p>
    <h2>Un espacio para nuestras novedades.</h2>
    <p>
      Todavía no hay publicaciones para mostrar. Acá vas a encontrar noticias, actividades y logros
      de la gestión.
    </p>
    <a class="text-link" href="/contacto/">
      Comunicate con la institución →
    </a>
  </div>
)}
<script>
  import '../scripts/news';
</script>
