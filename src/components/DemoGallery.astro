---
import { Image, getImage } from 'astro:assets';
import { demoPhotos } from '../lib/demo-photos';
const photos = await Promise.all(
  [demoPhotos.habitacion, demoPhotos.patio].map(async (photo) => ({
    ...photo,
    full: await getImage({ src: photo.src, width: 1440, format: 'webp', quality: 82 }),
  })),
);
const first = photos[0];
---

<section class="wrap page-section photo-gallery" aria-labelledby="gallery-title" data-photo-gallery>
  <div class="gallery-heading">
    <div>
      <p class="eyebrow dark">Propuesta fotográfica</p>
      <h2 id="gallery-title">Una mirada a los espacios.</h2>
    </div>
    <p>
      Imágenes ficticias generadas con IA para visualizar el diseño. No corresponden al alojamiento
      real.
    </p>
  </div>
  <div class="photo-gallery-grid">
    {photos.map((photo) => (
      <figure>
        <a
          href={photo.full.src}
          target="_blank"
          rel="noopener noreferrer"
          data-gallery-open
          data-title={photo.title}
          data-alt={photo.alt}
          aria-label={'Ampliar: ' + photo.title + ' (imagen ficticia)'}
          aria-haspopup="dialog"
          aria-controls="photo-dialog"
        >
          <Image
            src={photo.src}
            alt={photo.alt}
            format="webp"
            quality={78}
            width={1440}
            widths={[480, 960, 1440]}
            sizes="(max-width: 800px) calc(100vw - 44px), 760px"
            loading="lazy"
          />
          <span class="gallery-enlarge" aria-hidden="true">
            Ampliar ↗
          </span>
        </a>
        <figcaption>{photo.title} · Imagen ilustrativa</figcaption>
      </figure>
    ))}
  </div>
  <dialog id="photo-dialog" class="photo-dialog" aria-labelledby="photo-dialog-title">
    <div class="photo-dialog-panel">
      <div class="photo-dialog-top">
        <p id="photo-dialog-title">Fotografías de muestra</p>
        <button type="button" data-gallery-close aria-label="Cerrar imagen ampliada">
          Cerrar ×
        </button>
      </div>
      <img
        data-gallery-image
        src={first.full.src}
        alt={first.alt}
        width={first.full.attributes.width}
        height={first.full.attributes.height}
        loading="lazy"
      />
      <div class="photo-dialog-controls">
        <button type="button" data-gallery-prev aria-label="Imagen anterior">
          ← Anterior
        </button>
        <p role="status" aria-live="polite" aria-atomic="true" data-gallery-status>
          1 / 2 · {first.title}
        </p>
        <button type="button" data-gallery-next aria-label="Imagen siguiente">
          Siguiente →
        </button>
      </div>
      <p class="photo-dialog-note">
        Imágenes ficticias generadas con IA. No corresponden al alojamiento real.
      </p>
    </div>
  </dialog>
</section>
<script>
  import '../scripts/photo-gallery';
</script>
