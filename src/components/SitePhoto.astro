---
import { Image } from 'astro:assets';
import { photos } from '../lib/photos';
interface Props {
  kind: string;
  variant?: 'wide' | 'compact' | 'card';
  loading?: 'eager' | 'lazy';
  sizes?: string;
  href?: string;
  linkLabel?: string;
  maxWidth?: number;
}
const {
  kind,
  variant = 'wide',
  loading = 'lazy',
  sizes: requestedSizes,
  href,
  linkLabel,
  maxWidth = 1440,
} = Astro.props;
const Frame = href ? 'a' : 'div';
const photo = photos[kind];
if (!photo) throw new Error('Fotografía no registrada: ' + kind);
const width = Math.min(maxWidth, photo.src.width);
const widths = [...new Set([480, 960, width].filter((value) => value <= width))];
const sizes =
  requestedSizes ??
  (variant === 'wide'
    ? '(max-width: 800px) calc(100vw - 44px), 1240px'
    : '(max-width: 800px) calc(100vw - 44px), 600px');
---

<figure
  class:list={['reference-photo', 'reference-photo--' + variant]}
  data-site-photo
  data-photo-kind={photo.kind}
  data-photo-key={kind}
>
  <Frame class="reference-photo-frame" href={href} aria-label={href ? linkLabel : undefined}>
    <Image
      src={photo.src}
      alt={photo.alt}
      format="webp"
      quality={78}
      width={width}
      widths={widths}
      sizes={sizes}
      loading={loading}
      fetchpriority={loading === 'eager' ? 'high' : undefined}
    />
    {photo.kind === 'reference' && <span class="reference-photo-badge">FOTO DE REFERENCIA</span>}
  </Frame>
</figure>
