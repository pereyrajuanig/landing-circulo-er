---
import type { CollectionEntry } from 'astro:content';
import { mailTo } from '../lib/contact';
import ReferencePhoto from './ReferencePhoto.astro';
import { servicePhotoKeys } from '../lib/reference-photos';
interface Props {
  institution: CollectionEntry<'institution'>['data'];
  services: CollectionEntry<'services'>[];
}
const { institution, services } = Astro.props;
---

<section id="servicios" class="section services">
  <div class="wrap">
    <div class="section-heading">
      <div>
        <p class="eyebrow dark">01 / BENEFICIOS PARA RETIRADOS Y PENSIONADOS</p>
        <h2>
          Tus beneficios.
          <br />
          <em>Tu bienestar, cada día.</em>
        </h2>
      </div>
      <p>
        Si te retiraste de la Policía o percibís una pensión vinculada a ella, estos servicios
        forman parte del acompañamiento del Círculo. Conocelos y consultá cómo acceder.
      </p>
    </div>
    <div class="service-list">
      {services.map((service) => (
        <details open={service.data.initiallyOpen}>
          <summary>
            <span class="service-number">{String(service.data.order + 1).padStart(2, '0')}</span>
            <span class="service-name">{service.data.name}</span>
            <span class="service-caption">{service.data.caption}</span>
            <span class="details-icon" aria-hidden="true">
              +
            </span>
          </summary>
          <div class="service-content">
            <div class="service-copy">
              <p>{service.data.description}</p>
              <a
                href={
                  service.data.target === 'email'
                    ? mailTo(institution.email, service.data.subject)
                    : '#alojamiento'
                }
              >
                {service.data.action}{' '}
                <span aria-hidden="true">{service.data.target === 'email' ? '↗' : '→'}</span>
              </a>
            </div>
            <ReferencePhoto kind={servicePhotoKeys[service.id] ?? 'salud'} variant="compact" />
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
