---
import type { CollectionEntry } from 'astro:content';
import ReferencePhoto from './ReferencePhoto.astro';
import { mailTo } from '../lib/contact';
interface Props {
  institution: CollectionEntry<'institution'>['data'];
}
const { institution } = Astro.props;
const [emailName, emailDomain] = institution.email.split('@');
---

<section id="contacto" class="section contact">
  <div class="wrap contact-grid">
    <div>
      <p class="eyebrow dark">06 / HABLEMOS</p>
      <h2>
        Contanos.
        <br />
        <em>Estamos para escucharte.</em>
      </h2>
      <p>
        Si te retiraste de la Policía o percibís una pensión vinculada a ella y querés consultar por
        los beneficios, acercate. El primer paso puede ser una conversación.
      </p>
      <a class="button button-navy" href={mailTo(institution.email)}>
        Quiero hacer una consulta <span aria-hidden="true">↗</span>
      </a>
    </div>
    <div class="contact-info">
      <ReferencePhoto kind="tramites" variant="compact" />
      <div>
        <span>TE ESPERAMOS EN LA SEDE CENTRAL</span>
        <h3>{institution.address}</h3>
        <p>
          {institution.city} · {institution.province} · CP {institution.postalCode}
        </p>
        <a href={institution.mapUrl} target="_blank" rel="noopener noreferrer">
          Ver ubicación <span aria-hidden="true">↗</span>
        </a>
      </div>
      <div>
        <span>TAMBIÉN PODÉS ESCRIBIRNOS</span>
        <a class="email" href={mailTo(institution.email)} aria-label={institution.email}>
          {emailName}
          <wbr />@{emailDomain} <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </div>
</section>
