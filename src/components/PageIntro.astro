---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import LineIcon from './LineIcon.astro';

interface Props {
  title: string;
  eyebrow: string;
  description: string;
  action: { label: string; href: string };
  background: ImageMetadata;
  note?: string;
  artSide?: 'left' | 'right' | 'bottom';
  panoramic?: boolean;
}
const {
  title,
  eyebrow,
  description,
  action,
  background,
  note,
  artSide = 'right',
  panoramic = false,
} = Astro.props;
const imageWidths = [
  ...new Set([640, 960, 1440, 1920, background.width].filter((width) => width <= background.width)),
].sort((a, b) => a - b);
---

<div
  class:list={[
    'page-intro',
    'page-intro--patrimonial',
    {
      'page-intro--art-left': artSide === 'left',
      'page-intro--art-bottom': artSide === 'bottom',
      'page-intro--panoramic': panoramic,
    },
  ]}
  data-editorial-intro
>
  <div class="intro-art" aria-hidden="true">
    <Image
      src={background}
      alt=""
      width={background.width}
      widths={imageWidths}
      sizes="(max-width: 700px) 800px, (max-width: 1100px) 100vw, calc(100vw - 244px)"
      format="webp"
      quality={78}
      loading="eager"
      fetchpriority="high"
    />
  </div>
  <div class="wrap intro-content">
    <nav class="breadcrumbs" aria-label="Ubicación">
      <a href="/">Inicio</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{title}</span>
    </nav>
    <div class="intro-copy">
      <p class="eyebrow dark">{eyebrow}</p>
      <h1 class="intro-title">{title}</h1>
      <p class="page-lead intro-lead">{description}</p>
      <a class="ps-button intro-action" href={action.href}>
        {action.label}
        <LineIcon name="arrow" size={21} />
      </a>
      {note && <p class="intro-note">{note}</p>}
    </div>
  </div>
</div>

<style>
  :global(.portal-system) .page-intro--patrimonial {
    --ps-heading-ink: var(--portal-red-light);
    --ps-heading-rule: var(--portal-red-light);
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: 16px 0 0;
    background: #012c4f;
    color: var(--paper);
    border-bottom: 3px solid var(--portal-red-ink);
  }
  .intro-art {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }
  .intro-art::after {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 58%;
    background: #012c4f;
    opacity: 0.94;
    border-right: 1px solid rgb(210 177 106 / 35%);
  }
  .intro-art :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .intro-content {
    position: relative;
  }
  :global(.portal-system) .page-intro--patrimonial .breadcrumbs {
    margin-bottom: 0;
    color: #e0e8ed;
  }
  .breadcrumbs a {
    color: var(--paper);
  }
  .intro-copy {
    width: 52%;
    max-width: 580px;
    text-align: left;
    padding: 32px 0 66px;
  }
  .intro-copy .eyebrow {
    display: block;
    text-align: left;
  }
  :global(.portal-system) .intro-title {
    max-width: 12ch;
    font-size: clamp(48px, 4.6vw, 68px);
    line-height: 1.08;
    color: var(--paper);
    margin: 16px 0 24px;
  }
  :global(.portal-system) .intro-title::after {
    margin-inline: 0;
  }
  :global(.portal-system) .intro-lead {
    max-width: 46ch;
    color: #f0f3f4;
    margin: 0;
    font-size: 1.125rem;
    line-height: 1.7;
  }
  :global(.portal-system) .intro-action {
    margin-top: 24px;
    gap: 22px;
    background: var(--paper);
    border-color: var(--gold);
    color: var(--navy);
  }
  :global(.portal-system) .intro-action:is(:hover, :focus-visible) {
    background: var(--gold);
    color: var(--navy);
  }
  :global(.portal-system) .intro-action:focus-visible,
  .breadcrumbs a:focus-visible {
    outline: 3px solid var(--gold);
    outline-offset: 5px;
  }
  :global(.portal-system) .intro-note {
    font: 0.9375rem/1.6 var(--sans);
    color: #e0e8ed;
    max-width: 43ch;
    margin: 14px 0 0;
  }
  .page-intro--art-left .intro-art::after {
    inset: 0 0 0 auto;
    border-right: 0;
    border-left: 1px solid rgb(210 177 106 / 35%);
  }
  .page-intro--art-left .intro-art :global(img) {
    object-position: left center;
  }
  .page-intro--art-left .breadcrumbs {
    width: 46%;
    max-width: 540px;
    margin-left: auto;
  }
  .page-intro--art-left .intro-copy {
    margin-left: auto;
    width: 46%;
    max-width: 540px;
  }
  :global(.portal-system) .page-intro--art-left .intro-title {
    max-width: 16ch;
    font-size: clamp(44px, 4.3vw, 64px);
  }
  :global(.portal-system) .page-intro--panoramic {
    background: #01264c;
  }
  .page-intro--panoramic .intro-art::after {
    width: 49%;
    background: #01264c;
    opacity: 0.86;
    border: 0;
  }
  @media (min-width: 1001px) {
    .page-intro--panoramic .intro-art {
      top: 48px;
    }
    .page-intro--panoramic .intro-art :global(img) {
      object-position: 34% bottom;
    }
    .page-intro--panoramic .intro-copy {
      padding-block: 26px 50px;
    }
  }
  @media (max-width: 1000px) {
    .page-intro--panoramic .intro-art :global(img) {
      object-position: 16% center;
    }

    .page-intro--art-left .breadcrumbs {
      width: 100%;
      max-width: none;
      margin-left: 0;
    }
    .page-intro--art-left .intro-copy {
      width: 100%;
      max-width: 740px;
      margin-left: 0;
    }

    .intro-art::after {
      display: none;
    }
    :global(.portal-system) .page-intro--patrimonial {
      padding-bottom: 256px;
    }
    .intro-copy {
      width: 100%;
      max-width: 740px;
      padding: 26px 0 28px;
    }
    :global(.portal-system) .intro-title {
      max-width: 18ch;
      font-size: clamp(48px, 6.5vw, 64px);
    }
    :global(.portal-system) .intro-lead {
      max-width: 65ch;
    }
    .intro-art {
      top: auto;
      height: 256px;
    }
    .intro-art :global(img) {
      object-position: right center;
    }
  }
  @media (max-width: 700px) {
    :global(.portal-system) .page-intro--patrimonial {
      padding-top: 10px;
      padding-bottom: 230px;
    }
    .intro-copy {
      padding: 22px 0 26px;
    }
    :global(.portal-system) .intro-title {
      font-size: clamp(40px, 11vw, 54px);
      margin-block: 14px 22px;
    }
    :global(.portal-system) .intro-action {
      width: 100%;
      justify-content: space-between;
      margin-top: 22px;
    }
    .intro-art {
      height: 230px;
    }
  }
  :global(.portal-system) .page-intro--art-bottom {
    display: flex;
    flex-direction: column;
    padding-bottom: 0;
    background: #042852;
  }
  .page-intro--art-bottom .intro-art {
    position: relative;
    inset: auto;
    z-index: auto;
    order: 1;
    height: auto;
    aspect-ratio: 4 / 1;
    min-height: 144px;
    max-height: 360px;
  }
  .page-intro--art-bottom .intro-art::after {
    display: none;
  }
  .page-intro--art-bottom .intro-art :global(img) {
    object-position: center bottom;
  }
  .page-intro--art-bottom .intro-copy {
    width: 100%;
    max-width: 820px;
    padding-block: 24px 28px;
  }
  :global(.portal-system) .page-intro--art-bottom .intro-title {
    max-width: none;
  }
  :global(.portal-system) .page-intro--art-bottom .intro-lead {
    max-width: 60ch;
  }
</style>
