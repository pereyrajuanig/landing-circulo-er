---
import { Image } from 'astro:assets';
import LineIcon from './LineIcon.astro';
import { heroCities, CITY_ROTATION_MS } from '../lib/hero-cities';
import colonArt from '../assets/cities/colon-background.png';
const scenes = [...heroCities].sort(
  (a, b) => Number(b.id === 'diamante') - Number(a.id === 'diamante'),
);
const localities = [...scenes, { id: 'colon', name: 'Colón', art: colonArt }];
const features = [
  { href: '/beneficios/salud/', icon: 'health', label: 'Salud y bienestar' },
  { href: '/alojamientos/', icon: 'bed', label: 'Alojamiento y turismo' },
  { href: '/salones/', icon: 'events', label: 'Salones para eventos' },
  { href: '#filiales', icon: 'people', label: 'Filiales en Entre Ríos' },
] as const;
---

<section id="inicio" class="portal-home-intro" aria-labelledby="hero-title" data-city-hero>
  <div
    class="portal-carousel"
    role="region"
    aria-roledescription="carrusel"
    aria-label="Patrimonio de nuestras localidades"
    data-city-carousel
    data-city-interval={CITY_ROTATION_MS}
    data-active-city={localities[0].id}
  >
    <div class="portal-hero-copy">
      <p class="portal-eyebrow">
        Comunidad policial entrerriana <span aria-hidden="true"></span>
      </p>
      <h1 id="hero-title">
        Al servicio de nuestros
        <br />
        <em>retirados y pensionados.</em>
      </h1>
      <svg class="portal-underline" viewBox="0 0 250 18" aria-hidden="true" fill="none">
        <path d="M4 13C66 3 174 2 246 10" />
      </svg>
      <p class="portal-hero-description">
        Acompañamiento, contención y beneficios para quienes sirvieron a Entre Ríos.
      </p>
      <div class="portal-hero-actions">
        <a class="portal-action-primary" href="#servicios">
          Conocé nuestros servicios <LineIcon name="arrow" size={20} />
        </a>
        <a class="portal-action-secondary" href="#institucion">
          Nuestra institución
        </a>
      </div>
    </div>
    {localities.map((city, index) => (
      <div
        class="portal-scene"
        id={'portal-scene-' + city.id}
        role="group"
        aria-roledescription="diapositiva"
        aria-label={city.name + ', ' + (index + 1) + ' de ' + localities.length}
        data-city-slide={city.id}
        data-city-illustration={city.id}
        hidden={index !== 0}
      >
        <Image
          src={city.art}
          alt=""
          format="webp"
          quality={80}
          width={1440}
          widths={[480, 960, 1152, 1440]}
          sizes="(min-width: 1101px) calc(100vw - 244px), (max-width: 750px) 1152px, 100vw"
          loading={index === 0 ? 'eager' : 'lazy'}
          fetchpriority={index === 0 ? 'high' : undefined}
        />
        <span class="portal-scene-location">
          <LineIcon name="pin" size={16} />
          {city.name}, Entre Ríos
        </span>
      </div>
    ))}
    <div class="portal-scene-pager">
      <button type="button" class="portal-scene-pause" data-city-rotation hidden>
        Pausar recorrido
      </button>
    </div>
  </div>

  <nav class="portal-feature-bar" aria-label="Accesos a servicios">
    {features.map((feature) => (
      <a href={feature.href}>
        <LineIcon name={feature.icon} size={34} />
        <span>{feature.label}</span>
      </a>
    ))}
  </nav>
</section>
<script>
  import '../scripts/city-carousel';
</script>
