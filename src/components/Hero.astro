---
import { Image } from 'astro:assets';
import crest from '../../public/assets/escudo.png';
---

<section id="inicio" class="hero" aria-labelledby="hero-title">
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">
        <span></span> BENEFICIOS PARA RETIRADOS Y PENSIONADOS DE LA POLICÍA
      </p>
      <h1 id="hero-title">
        Tu historia nos une.
        <br />
        <em>Seguimos a tu lado.</em>
      </h1>
      <p class="hero-description">
        Servicios, alojamientos y espacios para compartir. En el Círculo de Retirados y Pensionados
        de la Policía de Entre Ríos, seguimos acompañándote en esta etapa.
      </p>
      <p class="hero-welcome">
        Para quienes se retiraron de la Policía y para quienes perciben una pensión vinculada a
        ella.
      </p>
      <div class="hero-actions">
        <a class="button button-gold" href="#contacto">
          Hablemos <span aria-hidden="true">↗</span>
        </a>
        <a class="text-link" href="#servicios">
          Cómo podemos acompañarte <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
    <div class="hero-emblem">
      <div class="emblem-frame">
        <span class="emblem-label">NUESTRA HISTORIA, NUESTRO VÍNCULO</span>
        <Image
          src={crest}
          format="webp"
          quality={100}
          width={494}
          widths={[180, 360, 494]}
          sizes="(max-width: 800px) 140px, 180px"
          loading="eager"
          height="590"
          alt="Escudo institucional: sol, laureles y manos unidas"
        />
        <div class="emblem-caption">
          <p>
            Una comunidad
            <br />
            <strong>de la que sos parte.</strong>
          </p>
        </div>
        <span class="emblem-since">Acompañándonos desde 1975</span>
      </div>
    </div>
  </div>
  <div class="wrap hero-bottom">
    <span>Más de medio siglo compartiendo el camino</span>
    <a href="#institucion">
      Conocé nuestra historia <span aria-hidden="true">↓</span>
    </a>
  </div>
</section>
<nav class="benefit-paths wrap" aria-label="Conocé tus beneficios">
  <a href="/beneficios/">
    <span class="path-number">01 / TU BIENESTAR</span>
    <h2>
      Beneficios para vos<span aria-hidden="true">↗</span>
    </h2>
    <p>Salud, farmacia y orientación para lo cotidiano.</p>
  </a>
  <a href="/alojamientos/">
    <span class="path-number">02 / TU ESTADÍA</span>
    <h2>
      Alojamientos<span aria-hidden="true">↗</span>
    </h2>
    <p>Conocé los destinos y consultá por tu próxima visita.</p>
  </a>
  <a href="/salones/">
    <span class="path-number">03 / TUS ENCUENTROS</span>
    <h2>
      Salones para eventos<span aria-hidden="true">↗</span>
    </h2>
    <p>Un espacio para reunirnos y compartir momentos.</p>
  </a>
</nav>
