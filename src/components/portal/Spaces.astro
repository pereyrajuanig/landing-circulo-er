---
import { getCollection, getEntry } from 'astro:content';
import SectionHeading from './SectionHeading.astro';
import SitePhoto from '../SitePhoto.astro';
import PhotoGallery from '../PhotoGallery.astro';
import LineIcon from '../LineIcon.astro';
import { mailTo } from '../../lib/contact';
import { photos } from '../../lib/photos';
interface Props {
  full?: boolean;
}
const { full = false } = Astro.props;
const spaces = (await getCollection('spaces')).sort((a, b) => a.data.order - b.data.order);
const institution = await getEntry('institution', 'circulo');
if (!institution) throw new Error('Falta contacto institucional.');
const shown = full ? spaces : spaces.slice(0, 2);
const homeDetailPhotos: Record<string, string[]> = {
  'los-laureles': ['parana-laureles-salon-30', 'parana-laureles-parque'],
  'las-rosas': ['parana-las-rosas-exterior-07', 'parana-rosas-cocina'],
};
const galleryHref = (id: string) => '/salones/#' + id;
---

<section
  id="eventos"
  class:list={['ps-section', 'ps-spaces', { 'home-spaces': !full }]}
  aria-labelledby="ps-spaces-title"
>
  <div class="ps-wrap">
    {full ? (
      <SectionHeading
        id="ps-spaces-title"
        eyebrow="Salones y espacios"
        title="Salones para reuniones y celebraciones"
        description="Mirá las fotos y consultá por las fechas, el equipamiento y cuántas personas admite cada salón."
        href={full ? undefined : '/salones/'}
        action="Todos los espacios"
      />
    ) : (
      <div class="home-spaces-heading">
        <div>
          <p class="ps-kicker">Salones y espacios</p>
          <h2 id="ps-spaces-title">
            Un lugar para
            <br />
            <em>encontrarnos.</em>
          </h2>
        </div>
        <div class="home-spaces-heading-aside">
          <p>
            Reuniones, celebraciones y tiempo compartido. Conocé los espacios del Círculo y consultá
            cómo organizar tu encuentro.
          </p>
          <a class="ps-link" href="/salones/">
            Todos los espacios <LineIcon name="arrow" size={22} />
          </a>
        </div>
      </div>
    )}
    <div class="ps-space-mosaic">
      {shown.map(({ id, data }, i) => (
        <article
          class:list={[
            'ps-space',
            { 'ps-space-reverse': i % 2 === 1, 'ps-space-no-photo': !data.photoKeys.length },
          ]}
          id={id}
        >
          {data.photoKeys.length > 0 && (
            <div class="ps-space-visual">
              {full ? (
                <PhotoGallery
                  id={'space-gallery-' + id}
                  title={'Fotos de ' + data.name}
                  note="Mirá las fotos del salón y sus espacios."
                  photoKeys={data.photoKeys}
                  compact
                />
              ) : (
                <div class="ps-space-preview">
                  <SitePhoto
                    kind={data.photoKeys[0]}
                    variant="wide"
                    href={galleryHref(id)}
                    linkLabel={'Ver galería de ' + data.name}
                    sizes="(max-width: 700px) 90vw, (max-width: 1100px) 36vw, 30vw"
                  />
                  <div class="ps-space-preview-details">
                    {(homeDetailPhotos[id] ?? []).map((key) => (
                      <SitePhoto
                        kind={key}
                        variant="card"
                        href={galleryHref(id)}
                        linkLabel={'Ver galería: ' + photos[key].title}
                        sizes="(max-width: 700px) 44vw, 16vw"
                        maxWidth={480}
                      />
                    ))}
                  </div>
                </div>
              )}
            </div>
          )}
          <div class="ps-space-copy">
            <p class="ps-kicker">
              <LineIcon name="pin" size={18} />
              {data.locality}
            </p>
            <h3>{data.name}</h3>
            <p>{data.description}</p>
            <details class="ps-space-facts" open={full}>
              <summary>Características y capacidad</summary>
              <ul>
                {data.details.map((detail) => (
                  <li>{detail}</li>
                ))}
              </ul>
              {data.capacityNote && <p class="ps-capacity">{data.capacityNote}</p>}
              <p class="ps-note">{data.sourceNote}</p>
            </details>
            <a
              class="ps-button ps-button-outline"
              href={mailTo(
                institution.data.email,
                'Consulta sobre ' + data.name + ' en ' + data.locality,
              )}
            >
              Consultar disponibilidad <LineIcon name="arrow" size={20} />
            </a>
          </div>
        </article>
      ))}
    </div>
    {!full && (
      <div class="ps-space-more">
        <p class="ps-kicker">También en nuestras filiales</p>
        {spaces.slice(2).map(({ id, data }) => (
          <a href={galleryHref(id)} aria-label={'Ver galería de ' + data.name}>
            {photos[data.photoKeys[0]]?.kind === 'institutional' && (
              <SitePhoto
                kind={data.photoKeys[0]}
                variant="card"
                sizes="(max-width: 520px) 90vw, (max-width: 900px) 45vw, 22vw"
                maxWidth={640}
              />
            )}
            <span>
              {data.locality}
              {id === 'federacion' && (
                <small class="ps-space-photo-context"> · Fotos de las obras</small>
              )}
            </span>
            <strong>{data.name}</strong>
            <LineIcon name="arrow" />
          </a>
        ))}
      </div>
    )}
  </div>
</section>

<style>
  :global(.portal-system) .home-spaces {
    background: #f8f3e9;
    padding-block: clamp(3.5rem, 7vw, 6.5rem);
  }
  .home-spaces-heading {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    align-items: end;
    gap: 1.5rem 3rem;
    margin-block-end: clamp(2rem, 4vw, 3.5rem);
  }
  :global(.portal-system) .home-spaces h2 {
    font-size: clamp(2.8rem, 5.6vw, 5.2rem);
    line-height: 1;
    letter-spacing: -0.035em;
  }
  :global(.portal-system) .home-spaces h2 em {
    color: var(--gold-ink);
  }
  .home-spaces-heading-aside {
    max-width: 38ch;
    padding-block-end: 0.4rem;
  }
  .home-spaces-heading-aside a {
    min-height: 44px;
  }
  :global(.portal-system) .home-spaces .ps-space-mosaic {
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(1.25rem, 3vw, 2.5rem);
    align-items: start;
  }
  :global(.portal-system) .home-spaces .ps-space {
    grid-template-columns: minmax(0, 1fr);
    gap: 0;
    padding: 0;
    border: 1px solid #d6c5a8;
    background: #fffaf1;
  }
  :global(.portal-system) .home-spaces .ps-space-reverse {
    margin-block-start: 5rem;
  }
  :global(.portal-system) .home-spaces .ps-space-reverse .ps-space-visual {
    order: 0;
  }
  .home-spaces .ps-space-preview {
    grid-template-columns: minmax(0, 1fr);
    gap: 0;
  }
  .home-spaces .ps-space-preview-details {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 5px;
    padding-top: 5px;
  }
  :global(.portal-system) .home-spaces .ps-space-visual {
    display: block;
  }
  :global(.portal-system) .home-spaces .ps-space-preview > :global(figure .reference-photo-frame) {
    aspect-ratio: 1.65;
    border-radius: 0;
  }
  :global(.portal-system) .home-spaces .ps-space-preview-details :global(.reference-photo-frame) {
    aspect-ratio: 2.6;
    border-radius: 0;
  }
  :global(.portal-system)
    .home-spaces
    .ps-space-preview
    :global([data-photo-kind='institutional'] img) {
    object-fit: cover;
  }
  :global(.portal-system) .home-spaces .ps-space-copy {
    padding: clamp(1.25rem, 3vw, 2.25rem);
  }
  :global(.portal-system) .home-spaces .ps-space-copy h3 {
    font-size: clamp(2.4rem, 4vw, 3.7rem);
    line-height: 1.05;
  }
  :global(.portal-system) .home-spaces .ps-space-copy > p {
    color: var(--navy);
    font-size: 1.125rem;
  }
  :global(.portal-system) .home-spaces .ps-space-copy .ps-kicker {
    color: var(--portal-red-ink);
  }
  :global(.portal-system) .home-spaces .ps-space-copy .ps-button {
    min-height: 48px;
  }
  :global(.portal-system) .home-spaces .ps-space-more {
    padding-top: 2rem;
    margin-top: 3rem;
    border-top: 1px solid #d6c5a8;
  }
  @media (max-width: 820px) {
    .home-spaces-heading {
      grid-template-columns: minmax(0, 1fr);
    }
    :global(.portal-system) .home-spaces .ps-space-mosaic {
      grid-template-columns: minmax(0, 1fr);
    }
    :global(.portal-system) .home-spaces .ps-space-reverse {
      margin-block-start: 0;
    }
  }
  .ps-space-preview {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    align-items: start;
    gap: 8px;
  }
  .ps-space-preview-details {
    display: grid;
    gap: 8px;
  }
  .ps-space-preview :global(a:focus-visible) {
    outline-offset: -5px;
  }
  :global(.portal-system) .ps-space-more {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
  .ps-space-more :global(figure) {
    grid-column: 1 / -1;
    margin-bottom: 6px;
  }
  .ps-space-more :global([data-photo-kind='institutional'] .reference-photo-frame img) {
    object-fit: cover;
  }
  @media (max-width: 900px) {
    :global(.portal-system) .ps-space-more {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 700px) {
    .ps-space-preview {
      grid-template-columns: minmax(0, 1fr);
    }
    .ps-space-preview-details {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 520px) {
    :global(.portal-system) .ps-space-more {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
