---
import { getCollection, getEntry } from 'astro:content';
import SectionHeading from './SectionHeading.astro';
import SitePhoto from '../SitePhoto.astro';
import PhotoGallery from '../PhotoGallery.astro';
import LineIcon from '../LineIcon.astro';
import { mailTo } from '../../lib/contact';
import { photos } from '../../lib/photos';
interface Props {
  full?: boolean;
}
const { full = false } = Astro.props;
const spaces = (await getCollection('spaces')).sort((a, b) => a.data.order - b.data.order);
const institution = await getEntry('institution', 'circulo');
if (!institution) throw new Error('Falta contacto institucional.');
const shown = full ? spaces : spaces.slice(0, 2);
const homeDetailPhotos: Record<string, string[]> = {
  'los-laureles': ['parana-laureles-salon-30', 'parana-laureles-parque'],
  'las-rosas': ['parana-las-rosas-exterior-07', 'parana-rosas-cocina'],
};
const galleryHref = (id: string) => '/salones/#' + id;
---

<section id="eventos" class="ps-section ps-spaces" aria-labelledby="ps-spaces-title">
  <div class="ps-wrap">
    <SectionHeading
      id="ps-spaces-title"
      eyebrow="Salones y espacios"
      title="Salones para reuniones y celebraciones"
      description="Mirá las fotos y consultá por las fechas, el equipamiento y cuántas personas admite cada salón."
      href={full ? undefined : '/salones/'}
      action="Todos los espacios"
    />
    <div class="ps-space-mosaic">
      {shown.map(({ id, data }, i) => (
        <article
          class:list={[
            'ps-space',
            { 'ps-space-reverse': i % 2 === 1, 'ps-space-no-photo': !data.photoKeys.length },
          ]}
          id={id}
        >
          {data.photoKeys.length > 0 && (
            <div class="ps-space-visual">
              {full ? (
                <PhotoGallery
                  id={'space-gallery-' + id}
                  title={'Fotos de ' + data.name}
                  note="Mirá las fotos del salón y sus espacios."
                  photoKeys={data.photoKeys}
                  compact
                />
              ) : (
                <div class="ps-space-preview">
                  <SitePhoto
                    kind={data.photoKeys[0]}
                    variant="wide"
                    href={galleryHref(id)}
                    linkLabel={'Ver galería de ' + data.name}
                    sizes="(max-width: 700px) 90vw, (max-width: 1100px) 36vw, 30vw"
                  />
                  <div class="ps-space-preview-details">
                    {(homeDetailPhotos[id] ?? []).map((key) => (
                      <SitePhoto
                        kind={key}
                        variant="card"
                        href={galleryHref(id)}
                        linkLabel={'Ver galería: ' + photos[key].title}
                        sizes="(max-width: 700px) 44vw, 16vw"
                        maxWidth={480}
                        showCaption={false}
                      />
                    ))}
                  </div>
                </div>
              )}
            </div>
          )}
          <div class="ps-space-copy">
            <p class="ps-kicker">
              <LineIcon name="pin" size={18} />
              {data.locality}
            </p>
            <h3>{data.name}</h3>
            <p>{data.description}</p>
            <details class="ps-space-facts" open={full}>
              <summary>Características y capacidad</summary>
              <ul>
                {data.details.map((detail) => (
                  <li>{detail}</li>
                ))}
              </ul>
              {data.capacityNote && <p class="ps-capacity">{data.capacityNote}</p>}
              <p class="ps-note">{data.sourceNote}</p>
            </details>
            <a
              class="ps-button ps-button-outline"
              href={mailTo(
                institution.data.email,
                'Consulta sobre ' + data.name + ' en ' + data.locality,
              )}
            >
              Consultar disponibilidad <LineIcon name="arrow" size={20} />
            </a>
          </div>
        </article>
      ))}
    </div>
    {!full && (
      <div class="ps-space-more">
        <p class="ps-kicker">También en nuestras filiales</p>
        {spaces.slice(2).map(({ id, data }) => (
          <a href={galleryHref(id)} aria-label={'Ver galería de ' + data.name}>
            {photos[data.photoKeys[0]]?.kind === 'institutional' && (
              <SitePhoto
                kind={data.photoKeys[0]}
                variant="card"
                sizes="(max-width: 520px) 90vw, (max-width: 900px) 45vw, 22vw"
                maxWidth={640}
                showCaption={false}
              />
            )}
            <span>
              {data.locality}
              {id === 'federacion' && (
                <small class="ps-space-photo-context"> · Fotos de las obras</small>
              )}
            </span>
            <strong>{data.name}</strong>
            <LineIcon name="arrow" />
          </a>
        ))}
      </div>
    )}
  </div>
</section>

<style>
  .ps-space-preview {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    align-items: start;
    gap: 8px;
  }
  .ps-space-preview-details {
    display: grid;
    gap: 8px;
  }
  .ps-space-preview :global(a:focus-visible) {
    outline-offset: -5px;
  }
  :global(.portal-system) .ps-space-more {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
  .ps-space-more :global(figure) {
    grid-column: 1 / -1;
    margin-bottom: 6px;
  }
  .ps-space-more :global([data-photo-kind='institutional'] .reference-photo-frame img) {
    object-fit: cover;
  }
  @media (max-width: 900px) {
    :global(.portal-system) .ps-space-more {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 700px) {
    .ps-space-preview {
      grid-template-columns: minmax(0, 1fr);
    }
    .ps-space-preview-details {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 520px) {
    :global(.portal-system) .ps-space-more {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
