---
import SitePhoto from '../SitePhoto.astro';
import LineIcon from '../LineIcon.astro';

const topics = [
  {
    title: 'Retiros, pensiones y subsidios',
    body: 'Preguntá por los requisitos, los pasos y los plazos de tu gestión.',
  },
  {
    title: 'Notas y reclamos',
    body: 'Consultá en Secretaría cómo preparar la presentación y dónde entregarla.',
  },
  {
    title: 'Documentación',
    body: 'Indicá tu localidad y el trámite que necesitás hacer para saber qué llevar.',
  },
];
---

<section class="ps-section home-tramites" aria-labelledby="home-tramites-title">
  <div class="ps-wrap guidance-layout">
    <header class="guidance-heading">
      <p class="ps-kicker">Orientación en la sede y en tu filial</p>
      <h2 id="home-tramites-title">
        Trámites
        <br />
        <em>y asesoramiento.</em>
      </h2>
      <p>Encontrá dónde consultar por tu gestión y qué documentación preparar.</p>
    </header>
    <div class="guidance-photo">
      <SitePhoto
        kind="parana-oficina-atencion"
        variant="card"
        sizes="(max-width: 820px) 90vw, 40vw"
        maxWidth={960}
      />
      <div class="guidance-local">
        <LineIcon name="people" size={28} />
        <div>
          <p>También podés empezar en tu localidad.</p>
          <a class="ps-link" href="/institucion/#filiales">
            Buscá tu filial <LineIcon name="arrow" size={20} />
          </a>
        </div>
      </div>
    </div>
    <div class="guidance-copy">
      <dl class="guidance-topics">
        {topics.map(({ title, body }) => (
          <div>
            <dt>{title}</dt>
            <dd>{body}</dd>
          </div>
        ))}
      </dl>
      <a class="ps-button" href="/beneficios/#tramites">
        Ver asesoramiento y consultas <LineIcon name="arrow" size={22} />
      </a>
    </div>
  </div>
</section>

<style>
  :global(.portal-system) .home-tramites {
    background: #f1f2ee;
    color: var(--navy);
  }
  .guidance-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    grid-template-areas: 'heading heading' 'photo copy';
    gap: clamp(1.75rem, 4vw, 3.5rem) clamp(1.5rem, 5vw, 4.5rem);
    align-items: start;
  }
  .guidance-heading {
    grid-area: heading;
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: 0 3rem;
    align-items: end;
    padding-inline-start: clamp(1rem, 3vw, 2rem);
    border-inline-start: 3px solid var(--portal-red);
  }
  .guidance-heading .ps-kicker {
    grid-column: 1 / -1;
  }
  :global(.portal-system) .home-tramites h2 {
    font-size: clamp(2.7rem, 5vw, 4.9rem);
    line-height: 1.02;
    letter-spacing: -0.03em;
  }
  :global(.portal-system) .home-tramites h2::after {
    display: none;
  }
  :global(.portal-system) .home-tramites h2 em {
    color: #9b252c;
  }
  .guidance-heading > p:last-child {
    max-width: 32ch;
    margin: 0 0 0.25rem;
    font-size: 1.2rem;
    line-height: 1.65;
  }
  .guidance-photo {
    grid-area: photo;
    min-width: 0;
  }
  :global(.portal-system) .home-tramites .guidance-photo :global(.reference-photo-frame) {
    aspect-ratio: 1.45;
    border-radius: 0.3rem 2rem 0.3rem 0.3rem;
  }
  .guidance-photo :global(img) {
    object-fit: cover;
  }
  .guidance-local {
    display: flex;
    gap: 1rem;
    align-items: start;
    padding: 1.25rem;
    background: #fffaf1;
    border-inline-start: 2px solid #b99358;
    margin-block-start: 1rem;
  }
  .guidance-local > :global(svg) {
    flex-shrink: 0;
    margin-block-start: 0.2rem;
    color: #9b252c;
  }
  .guidance-local p {
    margin: 0;
    font-size: 1.125rem;
  }
  .guidance-copy {
    grid-area: copy;
    min-width: 0;
  }
  .guidance-topics {
    margin: 0 0 1.5rem;
    border-block-start: 1px solid #a8b8b8;
  }
  .guidance-topics > div {
    padding-block: 1.15rem;
    border-block-end: 1px solid #a8b8b8;
  }
  .guidance-topics dt {
    font: 700 clamp(1.2rem, 1.8vw, 1.4rem) / 1.4 var(--sans);
    margin-block-end: 0.4rem;
  }
  .guidance-topics dd {
    font-size: 1.125rem;
    line-height: 1.65;
    margin: 0;
    max-width: 49ch;
  }
  :global(.portal-system) .home-tramites .ps-button {
    border-radius: 0.3rem;
  }
  @media (max-width: 820px) {
    .guidance-layout {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: 'heading' 'photo' 'copy';
    }
    .guidance-heading {
      grid-template-columns: minmax(0, 1fr);
      gap: 1rem;
    }
    .guidance-heading .ps-kicker {
      margin: 0;
    }
    .guidance-heading > p:last-child {
      max-width: 48ch;
    }
  }
</style>
