---
interface Props {
  id: string;
  eyebrow: string;
  title: string;
  description?: string;
  href?: string;
  action?: string;
}
const { id, eyebrow, title, description, href, action = 'Explorar' } = Astro.props;
---

<div class="ps-heading">
  <div>
    <p class="ps-kicker">{eyebrow}</p>
    <h2 id={id}>{title}</h2>
  </div>
  {(description || href) && (
    <div class="ps-heading-aside">
      {description && <p>{description}</p>}
      {href && (
        <a class="ps-link" href={href}>
          {action} <span aria-hidden="true">↗</span>
        </a>
      )}
    </div>
  )}
</div>
