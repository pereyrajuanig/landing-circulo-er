---
import { getEntry } from 'astro:content';
import SitePhoto from '../SitePhoto.astro';
import LineIcon from '../LineIcon.astro';
import { sanidadWhatsApp } from '../../lib/contact';
const institution = await getEntry('institution', 'circulo');
if (!institution) throw new Error('Falta la dirección de la sede central.');
---

<section id="salud-inicio" class="ps-section home-health" aria-labelledby="home-health-title">
  <div class="ps-wrap health-layout">
    <div class="health-photos">
      <SitePhoto
        kind="parana-consultorio-02"
        variant="card"
        sizes="(max-width: 740px) 86vw, 39vw"
      />
      <div class="health-photo-detail">
        <SitePhoto
          kind="parana-podologia-03"
          variant="card"
          sizes="(max-width: 740px) 40vw, 18vw"
          maxWidth={640}
        />
      </div>
      <p>
        <LineIcon name="pin" size={19} /> Sede central · {institution.data.address}, Paraná
      </p>
    </div>
    <div class="health-copy">
      <p class="ps-kicker">Sanidad del Círculo</p>
      <h2 id="home-health-title">
        Atención
        <br />
        <em>en Paraná.</em>
      </h2>
      <p>Conocé las especialidades de la sede central y consultá cómo acceder a la atención.</p>
      <ul class="health-specialties" aria-label="Especialidades de la sede central">
        <li>Atención médica</li>
        <li>Cardiología</li>
        <li>Enfermería</li>
        <li>Nutrición</li>
        <li>Fonoaudiología</li>
        <li>Podología</li>
      </ul>
      <a class="health-contact" href={sanidadWhatsApp.href}>
        Escribir a Sanidad <LineIcon name="arrow" size={22} />
      </a>
      <a class="ps-link" href="/beneficios/#atencion-parana">
        Ver especialidades y horarios <LineIcon name="arrow" size={20} />
      </a>
    </div>
  </div>
</section>

<style>
  :global(.portal-system) .home-health {
    background: #edf2ef;
    border-block: 1px solid #c2cfca;
  }
  .health-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }
  .health-photos {
    min-width: 0;
    position: relative;
    padding-block-end: 4rem;
    padding-inline-end: 2rem;
  }
  .health-photos > :global(figure) {
    padding: 0.6rem;
    border: 1px solid #9bac9f;
    border-radius: 44% 44% 0 0;
    background: #fffaf1;
  }
  .health-photos > :global(figure .reference-photo-frame) {
    aspect-ratio: 0.95;
    border-radius: 44% 44% 0 0;
  }
  .health-photos > :global(figure img) {
    object-fit: cover;
  }
  .health-photo-detail {
    position: absolute;
    right: 0;
    bottom: 3rem;
    width: 47%;
    padding: 0.5rem;
    background: #fffaf1;
    border: 1px solid #b5bda9;
  }
  .health-photo-detail :global(.reference-photo-frame) {
    aspect-ratio: 1.1;
    border-radius: 0;
  }
  .health-photo-detail :global(img) {
    object-fit: cover;
  }
  .health-photos > p {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0;
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    font-size: 1rem;
  }
  .health-photos > p :global(svg) {
    flex-shrink: 0;
  }
  :global(.portal-system) .home-health h2 {
    font-size: clamp(3rem, 5.8vw, 5.4rem);
  }
  :global(.portal-system) .home-health h2 em {
    color: var(--navy);
  }
  .health-copy > p:not(.ps-kicker) {
    margin-block: 1.3rem;
    max-width: 39ch;
  }
  .health-specialties {
    list-style: none;
    padding: 0;
    margin-block: 1.5rem;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 1rem;
  }
  .health-specialties li {
    padding-block: 0.6rem;
    border-block-start: 1px solid #b5c5bd;
    font-weight: 600;
  }
  .health-contact {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 54px;
    padding: 0.8rem 1.2rem;
    background: #ad2635;
    color: #fffaf1;
    font-weight: 700;
    border-radius: 5px;
  }
  .health-contact:hover {
    background: #8c1e2a;
  }
  .health-contact :global(svg) {
    flex-shrink: 0;
  }
  .health-copy > .ps-link {
    margin-block-start: 0.8rem;
  }
  @media (max-width: 740px) {
    .health-layout {
      grid-template-columns: minmax(0, 1fr);
    }
    .health-copy {
      order: -1;
    }
    .health-photos {
      max-width: 35rem;
      width: 100%;
      justify-self: center;
    }
  }
  @media (max-width: 380px) {
    .health-specialties {
      grid-template-columns: minmax(0, 1fr);
    }
    .health-photos {
      padding-inline-end: 1rem;
    }
  }
</style>
