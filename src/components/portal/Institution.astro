---
import { getCollection, getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import art from '../../assets/cities/concepcion-del-uruguay-background.png';
import SitePhoto from '../SitePhoto.astro';
import LineIcon from '../LineIcon.astro';
interface Props {
  full?: boolean;
}
const { full = false } = Astro.props;
const [entry, branches, services, stays] = await Promise.all([
  getEntry('institution', 'circulo'),
  getCollection('branches'),
  getCollection('services'),
  getCollection('stays'),
]);
if (!entry) throw new Error('Falta institución.');
---

<section id="institucion" class="ps-section ps-institution" aria-labelledby="ps-institution-title">
  <div class="ps-wrap">
    <div class="ps-story-heading">
      <p class="ps-kicker">Nuestra institución · Desde 1975</p>
      <h2 id="ps-institution-title">
        Una historia compartida.
        <br />
        <em>Un vínculo que continúa.</em>
      </h2>
      <p>Representación, orientación y encuentro para retirados, pensionados y sus familias.</p>
    </div>
    <div class="ps-story-grid">
      <div class="ps-story-timeline">
        <div class="ps-milestone">
          <span>21 · 09 · 1975</span>
          <h3>El comienzo de nuestro Círculo.</h3>
          <p>{entry.data.history[0]}</p>
        </div>
        <div class="ps-milestone">
          <span>Nuestro propósito</span>
          <h3>Seguir acompañándonos.</h3>
          <p>{entry.data.history[1]}</p>
        </div>
        {!full && (
          <a class="ps-button ps-button-outline" href="/institucion/">
            Conocé la institución <LineIcon name="arrow" size={20} />
          </a>
        )}
      </div>
      <div class="ps-story-art">
        <Image
          src={art}
          alt="Ilustración del patrimonio arquitectónico de Concepción del Uruguay"
          width={960}
          widths={[480, 960]}
          sizes="(max-width: 700px) 90vw, 40vw"
          format="webp"
          loading="lazy"
        />
        <p>La identidad de nuestra provincia, parte de nuestra historia.</p>
        {full && <SitePhoto kind="federal-nueva-sede-15" variant="card" />}
      </div>
    </div>
    <dl class="ps-statistics">
      <div>
        <dt>Filiales en la provincia</dt>
        <dd>{branches.length}</dd>
      </div>
      <div>
        <dt>Áreas de servicios publicadas</dt>
        <dd>{services.length}</dd>
      </div>
      <div>
        <dt>Destinos de alojamiento en el sitio</dt>
        <dd>{stays.length}</dd>
      </div>
    </dl>
  </div>
</section>
