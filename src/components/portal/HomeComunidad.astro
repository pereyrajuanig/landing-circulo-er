---
import SitePhoto from '../SitePhoto.astro';
import LineIcon from '../LineIcon.astro';
---

<section class="ps-section home-comunidad" aria-labelledby="home-comunidad-title">
  <div class="ps-wrap community-layout">
    <header class="community-heading">
      <p class="ps-kicker">Encuentros, talleres y viajes</p>
      <h2 id="home-comunidad-title">
        Recreación
        <br />
        <em>y comunidad.</em>
      </h2>
      <p>
        Encontrarse, aprender y compartir tiempo. Consultá en tu filial por las próximas actividades
        y cómo participar.
      </p>
      <a class="ps-button community-button" href="/beneficios/#recreacion">
        Conocé las actividades <LineIcon name="arrow" size={22} />
      </a>
    </header>
    <div class="community-photo">
      <SitePhoto
        kind="concordia-encuentro-social-11"
        variant="wide"
        href="/filiales/concordia/"
        linkLabel="Conocé la filial y los encuentros en Concordia"
        sizes="(max-width: 820px) 90vw, 49vw"
        maxWidth={1200}
      />
    </div>
    <div class="community-invitation">
      <div>
        <h3>Un espacio para reunirte con tu gente</h3>
        <p>
          Conocé los salones y espacios del Círculo. Mirá sus fotos y consultá por fechas,
          equipamiento y condiciones de uso.
        </p>
      </div>
      <a class="ps-link" href="/salones/">
        Ver salones y espacios <LineIcon name="arrow" size={22} />
      </a>
    </div>
  </div>
</section>

<style>
  :global(.portal-system) .home-comunidad {
    --ps-heading-rule: #ef8c7d;
    --ps-heading-ink: #ef8c7d;
    background: #0b2e46;
    color: #fff9ed;
  }
  .community-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    grid-template-areas: 'photo heading' 'invitation invitation';
    gap: clamp(1.5rem, 4.5vw, 4rem);
    align-items: center;
  }
  .community-heading {
    grid-area: heading;
    min-width: 0;
  }
  :global(.portal-system) .home-comunidad h2 {
    font-size: clamp(2.6rem, 4.6vw, 4.8rem);
    line-height: 1.03;
    letter-spacing: -0.025em;
  }
  :global(.portal-system) .home-comunidad h2 em {
    color: #f0d4a1;
  }
  .community-heading > p:not(.ps-kicker) {
    margin-block: 1.4rem;
    max-width: 35ch;
    font-size: 1.125rem;
    color: #eeeae0;
  }
  :global(.portal-system) .home-comunidad .community-button {
    background: #f0d4a1;
    border-color: #f0d4a1;
    color: #0b2e46;
    border-radius: 0.3rem;
  }
  :global(.portal-system) .home-comunidad .community-button:hover {
    background: #fff9ed;
  }
  .community-photo {
    grid-area: photo;
    min-width: 0;
    padding: 0.6rem;
    border: 1px solid #c0aa81;
    background: #fff9ed;
  }
  :global(.portal-system) .home-comunidad .community-photo :global(.reference-photo-frame) {
    aspect-ratio: 16 / 10;
    border-radius: 0;
    background: #fff9ed;
  }
  .community-photo :global(img) {
    object-fit: contain;
  }
  .community-invitation {
    grid-area: invitation;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 1.25rem 2.5rem;
    padding-block-start: clamp(1.5rem, 3vw, 2.25rem);
    border-block-start: 1px solid #d9b77d70;
  }
  :global(.portal-system) .home-comunidad .community-invitation h3 {
    font: 600 clamp(1.25rem, 2vw, 1.5rem) / 1.4 var(--sans);
    letter-spacing: normal;
  }
  .community-invitation p {
    margin: 0.5rem 0 0;
    max-width: 64ch;
    color: #d8e1e4;
    font-size: 1.125rem;
  }
  .community-invitation a {
    color: #f0d4a1;
  }
  :global(.portal-system) .home-comunidad a:focus-visible {
    outline-color: #f0d4a1;
  }
  @media (max-width: 820px) {
    .community-layout {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: 'heading' 'photo' 'invitation';
    }
    .community-heading > p:not(.ps-kicker) {
      max-width: 50ch;
    }
    .community-invitation {
      grid-template-columns: minmax(0, 1fr);
    }
    .community-invitation a {
      justify-self: start;
    }
  }
</style>
