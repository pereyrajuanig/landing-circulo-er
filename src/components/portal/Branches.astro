---
import { getCollection, getEntry } from 'astro:content';
import MapaFiliales from '../MapaFiliales.astro';
import SitePhoto from '../SitePhoto.astro';
import LineIcon from '../LineIcon.astro';
import { mailTo } from '../../lib/contact';
interface Props {
  full?: boolean;
}
const { full = false } = Astro.props;
const branches = (await getCollection('branches')).sort((a, b) => a.data.order - b.data.order);
const entry = await getEntry('institution', 'circulo');
if (!entry) throw new Error('Falta institución.');
const profiles = await getCollection('localities');
const profileIds = new Set(profiles.map(({ id }) => id));
const featured = branches
  .filter((b) => b.data.photoKey && b.data.overview)
  .slice(0, full ? branches.length : 3);
---

<section id="filiales" class="ps-section ps-branches" aria-labelledby="ps-branches-title">
  <div class="ps-wrap">
    <div class="ps-branches-masthead">
      <div>
        <p class="ps-kicker">Presencia provincial</p>
        <h2 id="ps-branches-title">
          Encontrá tu filial
          <br />
          <em>en Entre Ríos.</em>
        </h2>
        <p>
          Una sede central y {branches.length} filiales para sostener el vínculo con la comunidad
          policial entrerriana.
        </p>
      </div>
      <MapaFiliales />
    </div>
    <div class="ps-directory">
      <div class="ps-directory-tools">
        <label for="branch-search">Encontrá tu localidad</label>
        <input
          id="branch-search"
          type="search"
          autocomplete="off"
          placeholder="Escribí una localidad…"
          aria-controls="branch-list"
        />
        <p id="branch-status" role="status" aria-live="polite" aria-atomic="true"></p>
        <a class="ps-central" href="/filiales/parana/">
          <LineIcon name="institution" size={28} />
          <span>
            <small>Sede central · Paraná</small>
            <strong>{entry.data.address}</strong>
            <span>Ver sede, contacto y ubicación ↗</span>
          </span>
        </a>
        <p class="ps-note">Si necesitás hablar con una filial, la sede central te orienta.</p>
      </div>
      <ul id="branch-list" class="ps-branch-list" aria-label="Localidades con filiales">
        {branches.map(({ id, data }) => (
          <li>
            <a
              href={
                profileIds.has(id)
                  ? '/filiales/' + id + '/'
                  : mailTo(entry.data.email, 'Consulta sobre la filial ' + data.name)
              }
            >
              <span>{data.name}</span>
              <LineIcon name="arrow" size={19} />
              <span class="visually-hidden">
                {profileIds.has(id)
                  ? ': ver ficha de la filial'
                  : ': solicitar contacto a la sede central'}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
    <div class="ps-branch-life">
      <div class="ps-subheading">
        <h3>Sedes, actividades y encuentros</h3>
        <p>Conocé las sedes, los espacios y las actividades de {profiles.length} localidades.</p>
      </div>
      <div class="ps-branch-stories">
        {(full
          ? profiles.map(({ id, data }) => ({
              id,
              name: data.name,
              overview: data.summary,
              photoKey: data.photoKeys[0],
            }))
          : featured.map(({ id, data }) => ({
              id,
              name: data.name,
              overview: data.overview,
              photoKey: data.photoKey!,
            }))
        ).map(({ id, name, overview, photoKey }) => (
          <article>
            <SitePhoto
              kind={photoKey}
              variant="card"
              sizes="(max-width: 700px) 90vw, (max-width: 1100px) 45vw, 25vw"
            />
            <h4>{name}</h4>
            <p>{overview}</p>
            <a class="ps-link" href={'/filiales/' + id + '/'}>
              {id === 'parana' ? 'Ver ficha de la sede' : 'Ver ficha de la filial'}{' '}
              <LineIcon name="arrow" size={19} />
            </a>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>
