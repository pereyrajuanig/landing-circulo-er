---
import { getCollection } from 'astro:content';
import SectionHeading from './SectionHeading.astro';
import SitePhoto from '../SitePhoto.astro';
import LineIcon from '../LineIcon.astro';
const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const homePhotos: Record<string, string> = {
  salud: 'feliciano-sede-salud-terreno-17',
  tramites: 'parana-oficina-atencion',
  farmacia: 'federacion-beneficio-lentes',
  turismo: 'federacion-complejo-habitacional-13',
  recreacion: 'concordia-encuentro-social-11',
};
const icons = {
  salud: 'health',
  tramites: 'institution',
  farmacia: 'health',
  turismo: 'bed',
  recreacion: 'people',
} as const;
---

<section id="servicios" class="ps-section ps-services" aria-labelledby="ps-services-title">
  <div class="ps-wrap">
    <SectionHeading
      id="ps-services-title"
      eyebrow="Beneficios y servicios"
      title="Servicios y beneficios para acompañarte"
      description="Conocé las opciones de salud, asesoramiento, farmacia, alojamiento y recreación del Círculo. En cada área encontrás información para preparar tu consulta."
      href="/beneficios/"
      action="Todos los beneficios"
    />
    <div class="ps-service-grid">
      {services.map(({ id, data }, i) => (
        <article
          class:list={[
            'ps-service',
            { 'ps-service-featured': i === 0, 'ps-service-optica': id === 'farmacia' },
          ]}
        >
          <div class="ps-service-photo">
            <SitePhoto
              kind={homePhotos[id]}
              variant="card"
              sizes="(max-width: 700px) 90vw, (max-width: 1100px) 45vw, 36vw"
            />
          </div>
          <div class="ps-service-copy">
            <div class="ps-service-top">
              <LineIcon name={icons[id as keyof typeof icons]} size={30} />
              <span class="ps-index">0{i + 1}</span>
            </div>
            <p class="ps-kicker">{data.caption}</p>
            <h3>
              <a href={'/beneficios/' + id + '/'}>{data.name}</a>
            </h3>
            <p>{data.description}</p>
            <div class="ps-service-details">
              {data.details.map((detail) => (
                <details>
                  <summary>{detail.title}</summary>
                  <p>{detail.body}</p>
                </details>
              ))}
            </div>
            <a class="ps-link" href={'/beneficios/' + id + '/'}>
              Ver información y consultas <LineIcon name="arrow" size={20} />
            </a>
          </div>
        </article>
      ))}
    </div>
    <div class="ps-audience">
      <LineIcon name="people" size={30} />
      <p>
        <strong>Un vínculo con la comunidad policial.</strong> Los beneficios se dirigen a retirados
        de la Policía y a quienes perciben una pensión vinculada a ella. La institución confirma las
        condiciones de cada prestación.
      </p>
    </div>
  </div>
</section>
