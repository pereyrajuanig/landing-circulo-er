---
import { Image } from 'astro:assets';
import crest from '../../public/assets/escudo.png';
import type { CollectionEntry } from 'astro:content';
interface Props {
  institution: CollectionEntry<'institution'>['data'];
}
const { institution } = Astro.props;
---

<footer>
  <div class="wrap footer-top">
    <a class="brand footer-brand" href="#inicio">
      <Image
        src={crest}
        format="webp"
        quality={100}
        alt=""
        width={50}
        widths={[50, 100]}
        sizes="50px"
        loading="lazy"
        height="60"
      />
      <span>
        Círculo de Retirados y Pensionados<small>DE LA POLICÍA DE ENTRE RÍOS</small>
      </span>
    </a>
    <p>Historia. Compromiso. Comunidad.</p>
    <a href="#inicio">
      Volver al inicio <span aria-hidden="true">↑</span>
    </a>
  </div>
  <div class="wrap footer-bottom">
    <span>
      © <span id="year">{new Date().getFullYear()}</span> {institution.name}
    </span>
    <span>Entre Ríos, Argentina</span>
  </div>
</footer>
