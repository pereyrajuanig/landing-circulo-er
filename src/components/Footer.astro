---
import { Image } from 'astro:assets';
import crest from '../../public/assets/escudo.png';
import type { CollectionEntry } from 'astro:content';
interface Props {
  institution: CollectionEntry<'institution'>['data'];
}
const { institution } = Astro.props;
const home = Astro.url.pathname === '/' ? '' : '/';
---

<footer>
  <div class="wrap footer-top">
    <a class="brand footer-brand" href={home + '#inicio'}>
      <Image
        src={crest}
        format="webp"
        quality={100}
        alt=""
        width={50}
        widths={[50, 100]}
        sizes="50px"
        loading="lazy"
        height="60"
      />
      <span>
        Círculo de Retirados y Pensionados<small>DE LA POLICÍA DE ENTRE RÍOS</small>
      </span>
    </a>
    <p>Historia. Compromiso. Comunidad.</p>
    <a href={home + '#inicio'}>
      Volver al inicio <span aria-hidden="true">↑</span>
    </a>
  </div>
  <nav class="wrap site-directory" aria-label="Explorar el sitio">
    <a href="/beneficios/">Beneficios</a>
    <a href="/alojamientos/">Alojamientos</a>
    <a href="/salones/">Salones</a>
    <a href="/novedades/">Noticias y logros</a>
    <a href="/institucion/">Institución y filiales</a>
    <a href="/contacto/">Contacto</a>
  </nav>
  <div class="wrap footer-bottom">
    <span>
      © <span id="year">{new Date().getFullYear()}</span> {institution.name}
    </span>
    <span>Entre Ríos, Argentina</span>
  </div>
</footer>
