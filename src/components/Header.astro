---
import { Image } from 'astro:assets';
import crest from '../../public/assets/escudo.png';
const home = Astro.url.pathname === '/' ? '' : '/';
const links = [
  { href: '/beneficios/', label: 'Beneficios' },
  { href: '/alojamientos/', label: 'Alojamientos' },
  { href: '/salones/', label: 'Salones' },
  { href: '/novedades/', label: 'Novedades' },
  { href: '/contacto/', label: 'Contacto' },
];
---

<div class="topline">
  <div class="wrap">
    <span>Desde 1975 · Entre Ríos, Argentina</span>
    <a href="/contacto/">
      Sede Central · Paraná <span aria-hidden="true">↗</span>
    </a>
  </div>
</div>
<header class="header">
  <div class="wrap header-inner">
    <a
      class="brand"
      href={home + '#inicio'}
      aria-label="Círculo de Retirados y Pensionados, inicio"
    >
      <Image
        src={crest}
        format="webp"
        quality={100}
        width={50}
        widths={[50, 100]}
        sizes="50px"
        loading="eager"
        height="60"
        alt="Escudo del Círculo"
      />
      <span>
        Círculo de Retirados
        <br />y Pensionados<small>POLICÍA DE ENTRE RÍOS</small>
      </span>
    </a>
    <button type="button" class="menu-toggle" aria-expanded="false" aria-controls="navigation">
      Menú <span aria-hidden="true">☰</span>
    </button>
    <nav id="navigation" aria-label="Navegación principal">
      {links.map(({ href, label }) => (
        <a
          href={href}
          class:list={[label === 'Contacto' && 'nav-contact']}
          aria-current={Astro.url.pathname.startsWith(href) ? 'page' : undefined}
        >
          {label} {label === 'Contacto' && <span aria-hidden="true">↗</span>}
        </a>
      ))}
    </nav>
  </div>
</header>
