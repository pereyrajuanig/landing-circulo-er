---
import { Image } from 'astro:assets';
import crest from '../../public/assets/escudo.png';
---

<div class="topline">
  <div class="wrap">
    <span>Desde 1975 · Entre Ríos, Argentina</span>
    <a href="#contacto">
      Sede Central · Paraná <span aria-hidden="true">↗</span>
    </a>
  </div>
</div>
<header class="header">
  <div class="wrap header-inner">
    <a class="brand" href="#inicio" aria-label="Círculo de Retirados y Pensionados, inicio">
      <Image
        src={crest}
        format="webp"
        quality={100}
        width={50}
        widths={[50, 100]}
        sizes="50px"
        loading="eager"
        height="60"
        alt="Escudo del Círculo"
      />
      <span>
        Círculo de Retirados
        <br />y Pensionados<small>POLICÍA DE ENTRE RÍOS</small>
      </span>
    </a>
    <button type="button" class="menu-toggle" aria-expanded="false" aria-controls="navigation">
      Menú <span aria-hidden="true">☰</span>
    </button>
    <nav id="navigation" aria-label="Navegación principal">
      <a href="#servicios">Beneficios</a>
      <a href="#alojamiento">Alojamientos</a>
      <a href="#salones">Salones</a>
      <a href="#filiales">Filiales</a>
      <a class="nav-contact" href="#contacto">
        Contacto <span aria-hidden="true">↗</span>
      </a>
    </nav>
  </div>
</header>
