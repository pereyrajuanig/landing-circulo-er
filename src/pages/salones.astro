---
import SitePage from '../layouts/SitePage.astro';
import PageIntro from '../components/PageIntro.astro';
import salonsArt from '../assets/headers/salones-jardin-grabado.png';
import Spaces from '../components/portal/Spaces.astro';
---

<SitePage
  title="Salones del Círculo en Entre Ríos"
  seoTitle="Salones para eventos en Entre Ríos"
  seoDescription="Conocé Los Laureles, Las Rosas y los salones de las filiales del Círculo. Consultá ubicación, características, capacidad y condiciones de uso."
  eyebrow="Momentos en comunidad"
  description="Mirá las fotos de Los Laureles y Las Rosas en Paraná y de los salones de las filiales. Consultá capacidad, equipamiento y fechas."
>
  <PageIntro
    slot="intro"
    title="Salones del Círculo en Entre Ríos"
    eyebrow="Momentos en comunidad"
    description="Mirá las fotos de Los Laureles y Las Rosas en Paraná y de los salones de las filiales. Consultá capacidad, equipamiento y fechas."
    action={{ label: 'Ver salones', href: '#eventos' }}
    background={salonsArt}
  />
  <Spaces full />
  <section class="wrap page-section faq-section" aria-labelledby="events-faq">
    <h2 id="events-faq">Cómo consultar por un salón</h2>
    <details>
      <summary>¿Qué información incluyo en mi consulta?</summary>
      <p>
        Indicá la fecha estimada, el tipo de encuentro, la cantidad aproximada de personas y las
        necesidades de accesibilidad.
      </p>
    </details>
    <details>
      <summary>¿Dónde confirmo equipamiento y disponibilidad?</summary>
      <p>
        La institución informa las condiciones vigentes. La consulta desde la web no confirma fechas
        ni una reserva.
      </p>
    </details>
  </section>
</SitePage>
