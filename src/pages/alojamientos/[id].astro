---
import { getCollection, getEntry } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import SitePage from '../../layouts/SitePage.astro';
import PhotoGallery from '../../components/PhotoGallery.astro';
import LineIcon from '../../components/LineIcon.astro';
import { mailTo } from '../../lib/contact';
export async function getStaticPaths() {
  return (await getCollection('stays')).map((stay) => ({
    params: { id: stay.id },
    props: { stay },
  }));
}
interface Props {
  stay: CollectionEntry<'stays'>;
}
const { stay } = Astro.props;
const entry = await getEntry('institution', 'circulo');
if (!entry) throw new Error('Falta el contacto institucional.');
const inquiry = mailTo(entry.data.email, 'Consulta de alojamiento en ' + stay.data.name);
---

<SitePage
  title={'Alojamiento en ' + stay.data.name}
  eyebrow="Tu estadía en Entre Ríos"
  description={stay.data.description}
  parent={{ label: 'Alojamientos', href: '/alojamientos/' }}
>
  <PhotoGallery stayId={stay.id} />
  <section class="wrap page-section ps-stay-detail" aria-labelledby="stay-information-title">
    <div class="ps-stay-facts">
      <p class="ps-kicker">El alojamiento</p>
      <h2 id="stay-information-title">Organizá tu próxima visita.</h2>
      {stay.data.location && (
        <p>
          <strong>Ubicación</strong>
          <br />
          {stay.data.location}
        </p>
      )}
      <ul>
        {stay.data.details.map((detail) => (
          <li>{detail}</li>
        ))}
      </ul>
      {stay.data.sourceNote && <p class="ps-note">{stay.data.sourceNote}</p>}
      <div class="faq-section">
        <h3>Para organizarte mejor.</h3>
        <details>
          <summary>¿Puedo reservar desde esta página?</summary>
          <p>
            La web prepara una consulta por correo. Las reservas se coordinan directamente con la
            institución, según disponibilidad.
          </p>
        </details>
        <details>
          <summary>¿Pueden ir familiares y acompañantes?</summary>
          <p>
            Incluí esa información en tu consulta. La institución confirma las condiciones para cada
            visita.
          </p>
        </details>
      </div>
    </div>
    <aside class="ps-booking" aria-labelledby="stay-planning">
      <p class="ps-kicker">Planificá tu estadía</p>
      <h2 id="stay-planning">Tu visita empieza con una consulta.</h2>
      <p>Contanos el destino, las fechas y cuántas personas viajarían.</p>
      <a class="ps-button" href={inquiry}>
        Consultar disponibilidad <LineIcon name="arrow" size={20} />
      </a>
      <p class="ps-note">La consulta por correo no confirma una reserva.</p>
      <ul>
        <li>Fechas, tarifas y forma de reserva</li>
        <li>Habitaciones, capacidad y equipamiento</li>
        <li>Condiciones para acompañantes</li>
        <li>Ingreso y necesidades de accesibilidad</li>
      </ul>
    </aside>
  </section>
  <div class="wrap page-back">
    <a class="ps-link" href="/alojamientos/">
      ← Explorar otros destinos
    </a>
  </div>
  <div class="ps-mobile-inquiry">
    <a class="ps-button" href={inquiry}>
      Consultar disponibilidad <LineIcon name="arrow" size={20} />
    </a>
  </div>
</SitePage>
