---
import { getCollection, getEntry } from 'astro:content';
import SitePage from '../../layouts/SitePage.astro';
import PageIntro from '../../components/PageIntro.astro';
import LineIcon from '../../components/LineIcon.astro';
import SitePhoto from '../../components/SitePhoto.astro';
import Sanidad from '../../components/Sanidad.astro';
import benefitsArt from '../../assets/headers/beneficios-consultorio-grabado.png';
import { mailTo } from '../../lib/contact';
import { servicePhotoKeys } from '../../lib/photos';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const institution = await getEntry('institution', 'circulo');
if (!institution) throw new Error('Faltan los datos de contacto del Círculo.');
const { email, address } = institution.data;
const localities = await getCollection('localities');
const localitiesByBenefit: Record<string, string[]> = {
  tramites: ['parana', 'chajari', 'crespo', 'hasenkamp', 'feliciano'],
  recreacion: ['concordia', 'rosario-del-tala', 'federacion', 'federal'],
};
const serviceLocalities = (id: string) =>
  (localitiesByBenefit[id] ?? []).flatMap((localityId) =>
    localities.filter(({ id }) => id === localityId),
  );
const title = 'Beneficios y servicios del Círculo';
const eyebrow = 'Para retirados y pensionados policiales';
const description =
  'Encontrá cómo solicitar reintegros de OSER y anteojos sin cargo. Consultá también por turnos, trámites, farmacia, alojamiento y actividades.';
const orientation = [
  {
    icon: 'people',
    title: 'Consultas en tu localidad',
    description: 'Preguntá en tu filial por formularios, requisitos y servicios disponibles.',
    href: '/institucion/#filiales',
    action: 'Buscá tu filial',
  },
  {
    icon: 'health',
    title: 'Salud y turnos',
    description:
      'Encontrá el WhatsApp de Sanidad, las especialidades y los horarios de la sede central.',
    href: '#atencion-parana',
    action: 'Ver atención en Paraná',
  },
  {
    icon: 'mail',
    title: 'Consultas generales',
    description: 'Pedí orientación sobre un trámite o beneficio y averiguá con quién comunicarte.',
    href: '/contacto/',
    action: 'Ver canales de contacto',
  },
] as const;
---

<SitePage
  {title}
  seoTitle="Beneficios y servicios para retirados y pensionados policiales"
  {eyebrow}
  {description}
>
  <PageIntro
    slot="intro"
    {title}
    {eyebrow}
    {description}
    action={{ label: 'Explorar beneficios', href: '#servicios' }}
    background={benefitsArt}
    artSide="left"
  />

  <section id="servicios" class="wrap priority-section" aria-labelledby="prioridades-beneficios">
    <h2 id="prioridades-beneficios">Reintegros y anteojos para afiliados</h2>
    <div class="priority-grid">
      <div class="priority-refund">
        <div class="priority-code">
          <span>Código</span>
          <strong>817</strong>
        </div>
        <div class="priority-copy">
          <h3>Reintegros mensuales de OSER</h3>
          <p>
            Consultá las prestaciones y los códigos del beneficio para afiliados de toda Entre Ríos.
          </p>
          <a class="priority-action" href="#reintegros-oser">
            Ver reintegros y códigos <LineIcon name="arrow" size={24} />
          </a>
        </div>
      </div>
      <div class="priority-optical">
        <div class="priority-optical-mark">
          <LineIcon name="glasses" size={42} />
        </div>
        <h3>Plan Óptico Solidario</h3>
        <p>Anteojos sin cargo para la persona afiliada y su cónyuge.</p>
        <p class="priority-optical-note">Pedí el formulario en tu filial.</p>
        <a class="priority-action" href="#plan-optico">
          Ver cómo solicitarlo <LineIcon name="arrow" size={24} />
        </a>
      </div>
    </div>
    <nav class="benefits-index" aria-label="En esta página">
      <p>Ir a una sección</p>
      <ul>
        {services.map(({ id, data }) => (
          <li>
            <a href={'#' + id}>
              {data.name}
              <LineIcon name="arrow" size={18} />
            </a>
          </li>
        ))}
        <li>
          <a href="#atencion-parana">
            Atención y horarios en Paraná
            <LineIcon name="arrow" size={18} />
          </a>
        </li>
        <li>
          <a href="#ambulancia-parana">
            Ambulancia en Paraná
            <LineIcon name="arrow" size={18} />
          </a>
        </li>
        <li>
          <a href="#orientacion">
            Orientación para afiliados
            <LineIcon name="arrow" size={18} />
          </a>
        </li>
      </ul>
    </nav>
  </section>

  <section id="salud" class="wrap benefits-section" aria-labelledby="salud-title">
    <h2 id="salud-title">Salud y bienestar</h2>
    <Sanidad {address} />
  </section>

  {services
    .filter(({ id }) => id !== 'salud')
    .map(({ id, data }) => {
      if (id === 'turismo') {
        return (
          <section id={id} class="wrap benefits-section" aria-labelledby={id + '-title'}>
            <div class="benefit-stays">
              <div class="benefit-stays-copy">
                <h2 id={id + '-title'}>{data.name}</h2>
                <p>Elegí un destino en Entre Ríos para ver fotos y consultar cómo reservar.</p>
                <a class="ps-button" href="/alojamientos/">
                  Ver destinos de alojamiento <LineIcon name="arrow" size={23} />
                </a>
              </div>
              <SitePhoto
                kind={servicePhotoKeys[id]}
                variant="card"
                sizes="(max-width: 820px) 90vw, 45vw"
              />
            </div>
          </section>
        );
      }

      const href = data.target === 'email' ? mailTo(email, data.subject) : '/alojamientos/';
      if (id === 'farmacia') {
        const [pharmacy, ...otherBenefits] = data.details;
        return (
          <section id={id} class="wrap benefits-section" aria-labelledby={id + '-title'}>
            <div class="benefit-pharmacy">
              <h2 id={id + '-title'}>{data.name}</h2>
              <div class="pharmacy-main">
                <div class="pharmacy-emblem">
                  <LineIcon name="health" size={52} />
                </div>
                <div>
                  {pharmacy && <h3>{pharmacy.title}</h3>}
                  <p>{pharmacy?.body ?? data.description}</p>
                  <a class="ps-button" href={href}>
                    Consultar por Farmacia Social <LineIcon name="arrow" size={23} />
                  </a>
                </div>
              </div>
              {otherBenefits.length > 0 && (
                <div class="pharmacy-other">
                  {otherBenefits.map(({ title, body }) => (
                    <div class="benefit-detail">
                      <h3>{title}</h3>
                      <p>{body}</p>
                      {title === 'Plan Óptico Solidario' && (
                        <a class="text-link" href="#plan-optico">
                          Ver el Plan Óptico Solidario
                        </a>
                      )}
                    </div>
                  ))}
                </div>
              )}
            </div>
          </section>
        );
      }

      const locations = serviceLocalities(id);
      const isCommunity = id === 'recreacion';
      return (
        <section id={id} class="wrap benefits-section" aria-labelledby={id + '-title'}>
          <div
            class:list={['benefit-chapter', isCommunity ? 'benefit-community' : 'benefit-guide']}
          >
            <header class="benefit-heading">
              {!isCommunity && (
                <div class="benefit-guide-mark">
                  <LineIcon name="news" size={38} />
                </div>
              )}
              <div>
                <h2 id={id + '-title'}>{data.name}</h2>
                <p class="benefit-lead">{data.description}</p>
                {isCommunity && (
                  <div class="benefit-actions">
                    <a class="ps-button" href={href}>
                      {data.action} <LineIcon name="arrow" size={23} />
                    </a>
                    <a class="text-link" href="/salones/">
                      Ver salones y espacios
                    </a>
                  </div>
                )}
              </div>
            </header>
            <div class="benefit-copy">
              {data.details.map(({ title, body }) => (
                <div class="benefit-detail">
                  <h3>{title}</h3>
                  <p>{body}</p>
                </div>
              ))}
            </div>
            <div class="benefit-related">
              <SitePhoto
                kind={isCommunity ? servicePhotoKeys[id] : 'parana-oficina-atencion'}
                variant="card"
                sizes={
                  isCommunity ? '(max-width: 820px) 90vw, 44vw' : '(max-width: 820px) 90vw, 32vw'
                }
              />
              <div class="benefit-contacts">
                {locations.length > 0 && (
                  <>
                    <h3>Dónde consultar</h3>
                    <ul class="benefit-localities">
                      {locations.map(({ id, data }) => (
                        <li>
                          <a class="text-link" href={'/filiales/' + id + '/'}>
                            {data.name}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </>
                )}
                {!isCommunity && (
                  <div class="benefit-actions">
                    <a class="ps-button" href={href}>
                      {data.action} <LineIcon name="arrow" size={23} />
                    </a>
                  </div>
                )}
              </div>
            </div>
          </div>
        </section>
      );
    })}

  <section id="orientacion" class="wrap benefits-section" aria-labelledby="ayuda-beneficios">
    <div class="benefits-help">
      <div class="help-intro">
        <h2 id="ayuda-beneficios">Orientación para afiliados</h2>
        <p>
          Los beneficios están destinados a personas retiradas de la Policía y a quienes perciben
          una pensión policial.
        </p>
        <div class="help-before">
          <h3>Qué incluir en tu consulta</h3>
          <p>
            Indicá tu localidad y qué servicio necesitás. Si consultás por un alojamiento o salón,
            agregá las fechas y la cantidad de personas.
          </p>
        </div>
      </div>
      <ul class="help-options">
        {orientation.map(({ icon, title, description, href, action }) => (
          <li>
            <span class="help-icon">
              <LineIcon name={icon} size={27} />
            </span>
            <div>
              <h3>{title}</h3>
              <p>{description}</p>
              <a class="text-link" href={href}>
                {action} <LineIcon name="arrow" size={20} />
              </a>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>
</SitePage>

<style>
  .priority-section,
  .benefits-section {
    min-width: 0;
    scroll-margin-top: 7rem;
  }

  .priority-section {
    padding-block: clamp(2.5rem, 5.5vw, 5.5rem) 1rem;
  }

  .priority-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.75fr) minmax(0, 1fr);
    gap: clamp(1.25rem, 2.5vw, 2.5rem);
    margin-block-start: clamp(1.5rem, 3vw, 2.5rem);
  }

  .priority-refund {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.85fr);
    align-items: stretch;
    background: var(--navy);
    color: #fff9ed;
    border-radius: 0.75rem;
    border-inline-start: 4px solid var(--portal-red);
  }

  .priority-code {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 1.5rem 0.75rem;
    margin-block: 1rem;
    gap: 0.45rem;
    border-inline-end: 1px solid #d9b77d70;
    color: #f0d4a1;
  }

  .priority-code span {
    font-weight: 700;
  }

  .priority-code strong {
    font: 400 clamp(3rem, 5.2vw, 6rem) / 0.95 var(--serif);
    font-variant-numeric: lining-nums;
  }

  .priority-copy,
  .priority-optical {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.8rem;
    padding: clamp(1.25rem, 3vw, 2.5rem);
  }

  .priority-optical {
    border-block: 1px solid #baa783;
    background: #f5eada;
    color: var(--navy);
  }

  .priority-optical-mark {
    display: flex;
    width: 100%;
    align-items: center;
    gap: 0.8rem;
    color: var(--portal-red-ink);
  }

  .priority-optical-mark::after {
    content: '';
    flex: 1;
    border-block-start: 1px solid #baa783;
  }

  .priority-grid h3 {
    font-size: clamp(1.8rem, 2.85vw, 2.9rem);
    max-width: 19ch;
  }

  .priority-grid p {
    margin: 0;
    max-width: 38ch;
    color: inherit;
    font-size: 1.125rem;
  }

  .priority-optical-note {
    font-weight: 700;
  }

  .priority-action {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-block-start: auto;
    min-height: 44px;
    color: inherit;
    font-weight: 700;
    text-decoration: underline;
    text-decoration-color: #a37c45;
    text-underline-offset: 0.25em;
  }

  .priority-refund .priority-action {
    color: #f0d4a1;
    text-decoration-color: currentColor;
  }

  .priority-refund .priority-action:focus-visible {
    outline-color: #f0d4a1;
  }

  .priority-action:hover {
    text-decoration-thickness: 2px;
  }

  .benefits-index {
    display: grid;
    grid-template-columns: minmax(7.5rem, 1fr) minmax(0, 5fr);
    gap: 0.75rem 1.5rem;
    margin-block-start: clamp(2rem, 4vw, 3.5rem);
    padding-block: 1rem;
    border-block: 1px solid var(--ps-border);
  }

  .benefits-index p {
    margin: 0;
    align-self: start;
    padding-block-start: 0.65rem;
    font-weight: 700;
  }

  .benefits-index ul {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: 1.25rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .benefit-localities {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .benefits-index a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.45rem;
    min-height: 44px;
    color: var(--navy);
    padding: 0.45rem 0.2rem;
    border-block-end: 1px solid var(--ps-border);
    font-weight: 600;
  }

  .benefits-index a:hover {
    color: var(--portal-red-ink);
    text-decoration: underline;
    text-underline-offset: 0.22em;
  }

  .benefits-index a :global(svg),
  .priority-action :global(svg) {
    flex-shrink: 0;
  }

  .benefits-section {
    padding-block: clamp(2.25rem, 5vw, 4rem);
    border-block-end: 1px solid var(--ps-border);
  }

  .benefit-chapter {
    display: grid;
    align-items: start;
    gap: clamp(1.5rem, 4vw, 3.5rem);
  }

  .benefit-heading {
    grid-area: heading;
  }

  .benefit-copy {
    grid-area: copy;
  }

  .benefit-related {
    grid-area: related;
    min-width: 0;
  }

  .benefit-contacts h3 {
    margin-block-end: 0.5rem;
    font: 700 1.25rem / 1.4 var(--sans);
    letter-spacing: normal;
  }

  .benefit-guide {
    grid-template-areas: 'heading heading' 'copy related';
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    row-gap: clamp(1.25rem, 3.5vw, 2.5rem);
    padding: clamp(1.25rem, 3.6vw, 3rem);
    border-block-start: 3px solid var(--portal-red);
    background: #edf1ef;
  }

  .benefit-guide .benefit-heading {
    display: flex;
    align-items: flex-start;
    gap: clamp(0.8rem, 3vw, 1.5rem);
  }

  .benefit-guide-mark,
  .pharmacy-emblem {
    display: grid;
    place-items: center;
    flex: none;
    color: var(--portal-red-ink);
  }

  .benefit-guide-mark {
    width: 4rem;
    height: 4rem;
    border: 1px solid #94a7aa;
    border-radius: 0 0.75rem 0 0.75rem;
  }

  .benefit-guide .benefit-lead,
  .benefit-guide .benefit-detail {
    margin-block-end: 0;
  }

  .benefit-guide .benefit-detail {
    margin-block-start: 0;
    padding-block: 1.15rem;
    border-block-start: 1px solid #b3c2c4;
  }

  .benefit-guide .benefit-related :global(img) {
    object-fit: cover;
  }

  .benefit-guide .benefit-contacts {
    padding: 1.15rem;
    background: var(--paper);
    border-block-start: 1px solid #b3c2c4;
  }

  .benefit-pharmacy {
    padding: clamp(1.25rem, 3.6vw, 3rem);
    border: 1px solid #dac6a4;
    background: #fffaf1;
  }

  .pharmacy-main {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: clamp(1rem, 3vw, 2rem);
    align-items: start;
    padding: clamp(1rem, 3vw, 2rem);
    margin-block-start: 1.4rem;
    background: #f2e3c9;
    border-inline-start: 3px solid var(--portal-red);
  }

  .pharmacy-emblem {
    width: 5.25rem;
    height: 5.25rem;
    border: 1px solid #b28e62;
    border-radius: 50%;
  }

  .pharmacy-main h3 {
    font-size: clamp(2rem, 3.5vw, 3.3rem);
    line-height: 1.1;
  }

  .pharmacy-main p {
    margin-block-start: 0.75rem;
    max-width: 56ch;
  }

  .pharmacy-other {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: clamp(1rem, 4vw, 3rem);
  }

  .pharmacy-other .benefit-detail {
    padding-block-start: 1.1rem;
    border-block-start: 1px solid #dac6a4;
    margin-block-end: 0;
  }

  .pharmacy-other a {
    min-height: 44px;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .benefit-stays {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
    background: var(--navy);
    color: #fff9ed;
    border-radius: 0.85rem;
    border-block-start: 3px solid var(--portal-red);
  }

  .benefit-stays-copy {
    align-self: center;
    padding: clamp(1.25rem, 4.5vw, 4rem);
  }

  .benefit-stays p {
    margin-block: 1rem 1.4rem;
    max-width: 35ch;
  }

  .benefit-stays a {
    background: #f0d4a1;
    border-color: #f0d4a1;
    color: var(--navy);
  }

  .benefit-stays a:hover {
    background: #fff9ed;
    color: var(--navy);
  }

  .benefit-stays a:focus-visible {
    outline-color: #f0d4a1;
  }

  .benefit-stays > :global(figure) {
    min-height: clamp(15rem, 29vw, 25rem);
  }

  .benefit-stays :global(.reference-photo-frame) {
    position: absolute;
    inset: 0;
    aspect-ratio: auto;
    border-radius: 0 0.65rem 0.65rem 0;
  }

  .benefit-stays :global(img) {
    position: absolute;
    inset: 0;
    object-fit: cover;
  }

  .benefit-community {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    grid-template-areas: 'heading photo' 'copy copy' 'contacts contacts';
    row-gap: clamp(1.35rem, 3.5vw, 2.75rem);
    padding: clamp(1.25rem, 3.6vw, 3rem);
    border: 1px solid #dac6a4;
    border-block-start: 3px solid var(--portal-red);
    background: #f5ecde;
  }

  .benefit-community .benefit-heading {
    align-self: center;
  }

  .benefit-community .benefit-related {
    display: contents;
  }

  .benefit-community .benefit-related > :global(figure) {
    grid-area: photo;
    align-self: center;
    padding: 0.55rem;
    border: 1px solid #cdb896;
    background: #fffaf1;
  }

  .benefit-community :global(.reference-photo--card .reference-photo-frame) {
    aspect-ratio: 16 / 9;
    border-radius: 0;
  }

  .benefit-community .benefit-copy {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem clamp(1rem, 3vw, 2.5rem);
  }

  .benefit-community .benefit-detail {
    border-block-start: 1px solid #b9a17a;
    padding-block-start: 1rem;
    margin: 0;
  }

  .benefit-community .benefit-contacts {
    grid-area: contacts;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 1.5rem;
    align-items: center;
    padding: 0.75rem 1rem;
    background: #fffaf1;
    border-inline-start: 2px solid #a37c45;
  }

  .benefit-community .benefit-contacts h3 {
    margin: 0;
  }

  .benefit-community .text-link {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .benefits-help {
    --help-padding: clamp(1.25rem, 3.5vw, 2.75rem);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.45fr);
    border: 1px solid #cbd4d3;
    border-block-start: 3px solid #c9a468;
    background: #edf1ef;
  }

  .help-intro {
    --ps-heading-rule: #f68b80;
    padding: var(--help-padding);
    color: #fff9ed;
    background: var(--navy);
  }

  .help-intro > p {
    margin-block-start: 1.1rem;
  }

  .help-before {
    padding-block-start: 1rem;
    border-block-start: 1px solid #d9b77d70;
  }

  .help-before h3,
  .help-options h3 {
    font: 700 1.25rem / 1.4 var(--sans);
    letter-spacing: normal;
  }

  .help-before h3 {
    color: #f0d4a1;
  }

  .help-before p,
  .help-options p {
    margin: 0.4rem 0 0;
  }

  .help-options {
    align-self: center;
    list-style: none;
    padding: var(--help-padding);
    margin: 0;
  }

  .help-options li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.75rem 1.1rem;
  }

  .help-options li + li {
    margin-block-start: 0.8rem;
    padding-block-start: 1rem;
    border-block-start: 1px solid #b8c6c7;
  }

  .help-icon {
    display: grid;
    place-items: center;
    width: 2.65rem;
    height: 2.65rem;
    border: 1px solid #bdabaa;
    border-radius: 50%;
    color: var(--portal-red-ink);
  }

  .help-options a {
    min-height: 44px;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .benefit-lead {
    margin-block-start: 1rem;
