---
import SitePage from '../../layouts/SitePage.astro';
import Services from '../../components/portal/Services.astro';
import { getCollection } from 'astro:content';
import LineIcon from '../../components/LineIcon.astro';
const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
---

<SitePage
  title="Beneficios para acompañarte"
  eyebrow="Tu bienestar, cada día"
  description="Salud, orientación y espacios para compartir. Conocé los servicios del Círculo y prepará tu consulta."
>
  <Services />
  <section class="ps-section ps-benefit-highlights" aria-labelledby="benefit-paths">
    <div class="ps-wrap">
      <p class="ps-kicker">Encontrá tu próximo paso</p>
      <h2 id="benefit-paths">¿Qué necesitás hoy?</h2>
      <div class="ps-pathways">
        {services.slice(0, 3).map(({ id, data }) => (
          <a href={'/beneficios/' + id + '/'}>
            <span>{data.caption}</span>
            <strong>{data.name}</strong>
            <LineIcon name="arrow" />
          </a>
        ))}
      </div>
    </div>
  </section>
</SitePage>
