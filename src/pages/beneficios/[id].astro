---
import { getCollection, getEntry } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import SitePage from '../../layouts/SitePage.astro';
import { mailTo } from '../../lib/contact';
import SitePhoto from '../../components/SitePhoto.astro';
import PhotoGallery from '../../components/PhotoGallery.astro';
import { servicePhotoKeys } from '../../lib/photos';
export async function getStaticPaths() {
  return (await getCollection('services')).map((service) => ({
    params: { id: service.id },
    props: { service },
  }));
}
interface Props {
  service: CollectionEntry<'services'>;
}
const { service } = Astro.props;
const entry = await getEntry('institution', 'circulo');
if (!entry) throw new Error('Falta el contacto institucional.');
const { data } = service;
const href = data.target === 'email' ? mailTo(entry.data.email, data.subject) : '/alojamientos/';
const localitiesByBenefit: Record<string, string[]> = {
  salud: ['parana', 'diamante', 'federal', 'rosario-del-tala', 'feliciano', 'concordia'],
  tramites: ['parana', 'chajari', 'crespo', 'hasenkamp'],
  farmacia: ['federacion'],
  turismo: ['parana', 'concepcion-del-uruguay', 'maria-grande', 'federacion', 'feliciano'],
  recreacion: ['concordia', 'rosario-del-tala', 'federacion', 'federal'],
};
const localityIds = localitiesByBenefit[service.id] ?? [];
const localities = (await getCollection('localities'))
  .filter(({ id }) => localityIds.includes(id))
  .sort((a, b) => localityIds.indexOf(a.id) - localityIds.indexOf(b.id));
const questions: Record<string, string[]> = {
  salud: [
    'Especialidades y modalidades de atención',
    'Horarios y coordinación de turnos',
    'Condiciones de acceso y documentación',
  ],
  tramites: [
    'Alcance de la orientación para tu gestión',
    'Documentación que conviene preparar',
    'Canal y horario de atención',
  ],
  farmacia: [
    'Convenios y beneficios vigentes',
    'Requisitos para acceder',
    'Modalidad de consulta y atención',
  ],
  turismo: [
    'Destinos y fechas de tu visita',
    'Disponibilidad y condiciones de reserva',
    'Documentación y condiciones para familiares',
  ],
  recreacion: [
    'Espacios y actividades disponibles',
    'Fechas y condiciones de uso',
    'Contacto para organizar un encuentro',
  ],
};
---

<SitePage
  title={data.name}
  eyebrow={data.caption}
  description={data.description}
  parent={{ label: 'Beneficios', href: '/beneficios/' }}
>
  {service.id !== 'salud' && (
    <div class="wrap page-photo">
      <SitePhoto kind={servicePhotoKeys[service.id] ?? 'salud'} />
    </div>
  )}
  <section class="wrap page-section service-facts" aria-labelledby="service-facts-title">
    <p class="eyebrow dark">Conocé el beneficio</p>
    <h2 id="service-facts-title">Acompañamiento para lo cotidiano.</h2>
    <div class="service-facts-grid">
      {data.details.map((detail) => (
        <article>
          <h3>{detail.title}</h3>
          <p>{detail.body}</p>
        </article>
      ))}
    </div>
    {service.id === 'salud' && (
      <PhotoGallery
        id="salud-parana"
        title="Consultorios de Paraná"
        note="Consultá qué especialidades atienden actualmente y cómo pedir turno."
        photoKeys={[
          'parana-consultorio-02',
          'parana-podologia-03',
          'parana-consultorio-equipamiento',
          'parana-consultorio-mobiliario',
        ]}
        compact
      />
    )}
    {service.id === 'farmacia' && (
      <div class="service-photo-detail">
        <SitePhoto kind="federacion-beneficio-lentes" variant="compact" />
        <div>
          <h3>Beneficio para adquirir lentes en Federación</h3>
          <p>El archivo de la filial registra este beneficio. Consultá su vigencia y requisitos.</p>
        </div>
      </div>
    )}
    {localities.length > 0 && (
      <div class="service-localities">
        <h3>El archivo por localidad</h3>
        <ul>
          {localities.map(({ id, data: locality }) => (
            <li>
              <a class="text-link" href={'/filiales/' + id + '/'}>
                {locality.name}
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}
    {service.id === 'recreacion' && (
      <a class="text-link" href="/salones/">
        Conocer salones y espacios →
      </a>
    )}
  </section>
  <section class="wrap page-section detail-grid" aria-labelledby="service-consult">
    <div>
      <h2 id="service-consult">Encontrá orientación para tu consulta.</h2>
      <p>
        Comunicate con la institución para conocer el alcance y las condiciones actuales de este
        servicio.
      </p>
      <a class="button button-navy" href={href}>
        {data.action} <span aria-hidden="true">↗</span>
      </a>
      <p class="small-note">
        Dirigido a retirados de la Policía y personas con una pensión vinculada a ella. La
        institución confirma las condiciones que correspondan.
      </p>
    </div>
    <aside class="consultation-panel" aria-labelledby="service-questions">
      <p class="eyebrow dark">Antes de comunicarte</p>
      <h2 id="service-questions">Qué podés consultar</h2>
      <ul>
        {questions[service.id].map((question) => (
          <li>{question}</li>
        ))}
      </ul>
      <p class="small-note">
        Esta guía ayuda a preparar la consulta; no establece requisitos ni garantiza prestaciones.
      </p>
    </aside>
  </section>
  <div class="wrap page-back">
    <a class="text-link" href="/beneficios/">
      ← Ver todos los beneficios
    </a>
  </div>
</SitePage>

<style>
  .service-localities {
    margin-block: 2rem;
  }
  .service-localities ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    padding: 0;
    list-style: none;
  }
</style>
