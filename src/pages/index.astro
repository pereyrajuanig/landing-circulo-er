---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Institution from '../components/Institution.astro';
import Services from '../components/Services.astro';
import Branches from '../components/Branches.astro';
import Accommodation from '../components/Accommodation.astro';
import Community from '../components/Community.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';

const [entry, services, branches, stays] = await Promise.all([
  getEntry('institution', 'circulo'),
  getCollection('services'),
  getCollection('branches'),
  getCollection('stays'),
]);
if (!entry) throw new Error('Falta el contenido institucional del Círculo.');
const institution = entry.data;
services.sort((a, b) => a.data.order - b.data.order);
branches.sort((a, b) => a.data.order - b.data.order);
stays.sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title={institution.title} description={institution.description}>
  <Header />
  <main id="contenido">
    <Hero />
    <Institution institution={institution} />
    <Services institution={institution} services={services} />
    <Branches institution={institution} branches={branches} />
    <Accommodation institution={institution} stays={stays} />
    <Community />
    <Contact institution={institution} />
  </main>
  <Footer institution={institution} />
  <script>
    import '../scripts/landing';
  </script>
</BaseLayout>
