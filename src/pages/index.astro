---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PortalHeader from '../components/PortalHeader.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/portal/Services.astro';
import Localities from '../components/portal/Localities.astro';
import Stays from '../components/portal/Stays.astro';
import Spaces from '../components/portal/Spaces.astro';
import News from '../components/portal/News.astro';
import Institution from '../components/portal/Institution.astro';
import Branches from '../components/portal/Branches.astro';
import Contact from '../components/portal/Contact.astro';
import Footer from '../components/portal/Footer.astro';
import '../styles/portal-system.css';
const entry = await getEntry('institution', 'circulo');
if (!entry) throw new Error('Falta el contenido institucional del Círculo.');
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <div class="home-portal">
    <PortalHeader />
    <main id="contenido" tabindex="-1">
      <Hero />
      <div class="portal-system">
        <Services />
        <Localities />
        <Stays />
        <Spaces />
        <News />
        <Institution />
        <Branches />
        <Contact />
      </div>
    </main>
    <Footer />
  </div>

  <script>
    import '../scripts/landing';
    import '../scripts/portal';
  </script>
</BaseLayout>
