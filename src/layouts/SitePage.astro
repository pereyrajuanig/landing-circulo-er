---
import BaseLayout from './BaseLayout.astro';
import PortalHeader from '../components/PortalHeader.astro';
import Footer from '../components/portal/Footer.astro';
import StayIntroBackdrop from '../components/StayIntroBackdrop.astro';
import { CITY_ROTATION_MS } from '../lib/hero-cities';
import type { StayIntroPhoto } from '../lib/stay-intro-photos';
import '../styles/portal-system.css';
interface Props {
  title: string;
  seoTitle?: string;
  seoDescription?: string;
  pageType?: 'website' | 'article';
  description: string;
  eyebrow: string;
  parent?: { label: string; href: string };
  introPhotos?: readonly StayIntroPhoto[];
}
const { title, description, eyebrow, parent, seoTitle, seoDescription, pageType, introPhotos } =
  Astro.props;
const hasIntroPhotos = Boolean(introPhotos?.length);
---

<BaseLayout
  title={(seoTitle ?? title) + ' · Círculo de Retirados y Pensionados'}
  description={seoDescription ?? description}
  pageType={pageType}
>
  <div class="home-portal">
    <PortalHeader />
    <main id="contenido" tabindex="-1" class="portal-system">
      <slot name="intro">
        <div
          class:list={['page-intro', { 'page-intro--with-photos': hasIntroPhotos }]}
          data-city-hero={hasIntroPhotos || undefined}
          data-city-carousel={hasIntroPhotos || undefined}
          data-city-interval={hasIntroPhotos ? CITY_ROTATION_MS : undefined}
          data-active-city={hasIntroPhotos ? '1' : undefined}
        >
          <div class="wrap">
            <nav class="breadcrumbs" aria-label="Ubicación">
              <a href="/">Inicio</a>
              <span aria-hidden="true">/</span>
              {parent && (
                <>
                  <a href={parent.href}>{parent.label}</a>
                  <span aria-hidden="true">/</span>
                </>
              )}
              <span aria-current="page">{title}</span>
            </nav>
            <div class="page-intro-copy">
              <p class="eyebrow dark">{eyebrow}</p>
              <h1>{title}</h1>
              <p class="page-lead">{description}</p>
            </div>
            {hasIntroPhotos && introPhotos && <StayIntroBackdrop photos={introPhotos} />}
          </div>
        </div>
      </slot>
      <slot />
    </main>
    <Footer />
  </div>
  <script>
    import '../scripts/landing';
    import '../scripts/portal';
  </script>
</BaseLayout>

<style>
  :global(.portal-system) .page-intro--with-photos {
    position: relative;
    isolation: isolate;
    display: grid;
    min-height: clamp(400px, 37vw, 540px);
    padding-block: 22px;
    background: var(--navy);
    color: #fff;
    --ps-heading-ink: #ffd6c6;
    --ps-heading-rule: #f68b80;
  }

  .page-intro--with-photos > .wrap {
    display: flex;
    flex-direction: column;
  }

  .page-intro--with-photos .page-intro-copy {
    max-width: 640px;
    margin-block: auto;
    padding-block: clamp(18px, 4vw, 52px);
  }

  .page-intro--with-photos :is(h1, .page-lead, .breadcrumbs, .breadcrumbs a) {
    color: inherit;
  }

  .page-intro--with-photos .page-lead {
    margin-block-end: 0;
  }

  .page-intro--with-photos :is(a, button):focus-visible {
    outline-color: #ffd6a0;
  }
</style>
