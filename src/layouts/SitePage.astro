---
import { getEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
interface Props {
  title: string;
  description: string;
  eyebrow: string;
  parent?: { label: string; href: string };
}
const { title, description, eyebrow, parent } = Astro.props;
const entry = await getEntry('institution', 'circulo');
if (!entry) throw new Error('Falta el contenido institucional.');
---

<BaseLayout title={title + ' · Círculo de Retirados y Pensionados'} description={description}>
  <Header />
  <main id="contenido" tabindex="-1">
    <div class="page-intro">
      <div class="wrap">
        <nav class="breadcrumbs" aria-label="Ubicación">
          <a href="/">Inicio</a>
          <span aria-hidden="true">/</span>
          {parent && (
            <>
              <a href={parent.href}>{parent.label}</a>
              <span aria-hidden="true">/</span>
            </>
          )}
          <span aria-current="page">{title}</span>
        </nav>
        <p class="eyebrow dark">{eyebrow}</p>
        <h1>{title}</h1>
        <p class="page-lead">{description}</p>
      </div>
    </div>
    <slot />
  </main>
  <Footer institution={entry.data} />
  <script>
    import '../scripts/landing';
  </script>
</BaseLayout>
