---
import '../styles/styles.css';
import '../styles/warmth.css';
import '../styles/site.css';
import '../styles/photos.css';
import '../styles/hero-cities.css';
import { getDeployment, SITEMAP_INDEX } from '../../config/seo.mjs';
import { getEntry } from 'astro:content';
interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  pageType?: 'website' | 'article';
}
const { title, description, noindex = false, pageType = 'website' } = Astro.props;
const institution = await getEntry('institution', 'circulo');
if (!institution) throw new Error('Falta la identidad institucional para SEO.');
const { name, email, address, city, province, postalCode } = institution.data;
const deployment = getDeployment();
const indexable = deployment.indexable && !noindex;
const canonical =
  indexable && Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const home = indexable && Astro.url.pathname === '/' ? canonical : undefined;
const organizationId = home ? new URL('#organizacion', home).href : undefined;
const graph = home
  ? {
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'Organization',
          '@id': organizationId,
          name,
          url: home,
          logo: new URL('/assets/escudo.png', home).href,
          email,
          address: {
            '@type': 'PostalAddress',
            streetAddress: address,
            addressLocality: city,
            addressRegion: province,
            postalCode,
            addressCountry: 'AR',
          },
        },
        {
          '@type': 'WebSite',
          '@id': new URL('#sitio-web', home).href,
          name,
          url: home,
          inLanguage: 'es-AR',
          publisher: { '@id': organizationId },
        },
      ],
    }
  : undefined;
const schema = graph ? JSON.stringify(graph).replaceAll('<', '\\u003c') : undefined;
const socialImage = Astro.site
  ? new URL('/assets/social-card.png?v=portal-20261103', Astro.site).href
  : undefined;
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link
      rel="preload"
      href="/assets/fonts/dm-sans-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/assets/fonts/libre-caslon-display-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta name="theme-color" content="#092b48" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <meta name="robots" content={indexable ? 'index, follow' : 'noindex, follow'} />
    {canonical && <link rel="canonical" href={canonical} />}
    {canonical && <link rel="sitemap" href={'/' + SITEMAP_INDEX} type="application/xml" />}
    {schema && <script type="application/ld+json" set:html={schema} />}
    <meta property="og:type" content={pageType} />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content={name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImage && (
      <>
        <meta property="og:image" content={socialImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta
          property="og:image:alt"
          content="Escudo del Círculo, grabado de Diamante y mensaje: Al servicio de nuestros retirados y pensionados."
        />
        <meta name="twitter:image" content={socialImage} />
        <meta
          name="twitter:image:alt"
          content="Escudo del Círculo, grabado de Diamante y mensaje: Al servicio de nuestros retirados y pensionados."
        />
      </>
    )}
    <link rel="icon" href="/favicon.png" type="image/png" sizes="96x96" />
  </head>
  <body>
    <a class="skip-link" href="#contenido">
      Ir al contenido
    </a>
    <slot />
  </body>
</html>
